<file path="components/student-hub/RepDeskTab.tsx">
'use client';
import { useState, useEffect } from 'react';
import * as XLSX from 'xlsx';
import { Upload, Clock, FileText, Zap, PlayCircle, MapPin, Loader2, XCircle, Timer } from 'lucide-react';
import { ConfirmModal, useConfirmModal } from '@/components/ConfirmModal';
import { getStudentHeaders } from '@/utils/api-client';

const MATRIC_REGEX = /[\/\-]/;

interface RepDeskTabProps {
  records: { id: string; course_code: string }[];
  matricNumber: string;
  activeLiveSession: { course: string; sessionId: string; courseId: string } | null;
  onRefresh: () => void;
  addToast: (title: string, description?: string, type?: 'success' | 'error' | 'info') => void;
}

export default function RepDeskTab({
  records,
  matricNumber,
  activeLiveSession,
  onRefresh,
  addToast,
}: RepDeskTabProps) {
  const [repCourseId, setRepCourseId] = useState('');
  const [repBatteryMatric, setRepBatteryMatric] = useState('');
  const [isLoggingBattery, setIsLoggingBattery] = useState(false);
  const [isUploadingList, setIsUploadingList] = useState(false);
  const [repSessionDuration, setRepSessionDuration] = useState<number>(60);
  const [isStartingRepSession, setIsStartingRepSession] = useState(false);
  const [isEndingSession, setIsEndingSession] = useState(false);
  const [repSessionError, setRepSessionError] = useState('');

  const confirm = useConfirmModal();

  useEffect(() => {
    if (records.length > 0 && !repCourseId) {
      const id = setTimeout(() => setRepCourseId(records[0].id), 0);
      return () => clearTimeout(id);
    }
  }, [records, repCourseId]);

  const handleLogBattery = async () => {
    if (!activeLiveSession) {
      addToast('No active lecture', 'There is no live session to log against.', 'error');
      return;
    }
    if (!repBatteryMatric.trim()) {
      addToast('Matric number required', "Enter the student's matric number.", 'error');
      return;
    }

    setIsLoggingBattery(true);
    try {
      const headers = getStudentHeaders();
      const res = await fetch('/api/rep-action', {
        method: 'POST',
        headers,
        body: JSON.stringify({
          action: 'log_dead_battery',
          sessionId: activeLiveSession.sessionId,
          matricNumber: repBatteryMatric,
        }),
      });
      const data = await res.json();

      if (res.ok) {
        addToast('Dead battery logged', 'Ask the student to see the lecturer for approval.', 'success');
        setRepBatteryMatric('');
      } else {
        addToast('Log failed', data.error || 'Failed to log battery dead.', 'error');
      }
    } catch {
      addToast('Network error', 'Check your connection and try again.', 'error');
    } finally {
      setIsLoggingBattery(false);
    }
  };

  const handleRepUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file || !repCourseId) return;
    setIsUploadingList(true);

    const isExcel = file.name.endsWith('.xlsx') || file.name.endsWith('.xls');
    const isWord = file.name.endsWith('.docx');
    const isPdf = file.name.endsWith('.pdf');
    const reader = new FileReader();

    reader.onload = async (event) => {
      try {
        let rawMatrics: string[] = [];

        if (isExcel) {
          const data = new Uint8Array(event.target?.result as ArrayBuffer);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
          const jsonData = XLSX.utils.sheet_to_json(firstSheet, { header: 1 }) as string[][];

          jsonData.forEach((row) => {
            row.forEach((cell) => {
              if (typeof cell === 'string' && cell.length > 5 && MATRIC_REGEX.test(cell) && !cell.includes('MATRIC')) {
                rawMatrics.push(cell.trim().toUpperCase().replace(/[^A-Z0-9/\-]/g, ''));
              }
            });
          });
        } else if (isWord) {
          const mammoth = await import('mammoth');
          const arrayBuffer = event.target?.result as ArrayBuffer;
          const result = await mammoth.extractRawText({ arrayBuffer });
          const words = result.value.split(/[\s,]+/);
          rawMatrics = words.map(w => w.trim().toUpperCase().replace(/[^A-Z0-9/\-]/g, '')).filter(w => w.length > 5 && MATRIC_REGEX.test(w) && !w.includes('MATRIC'));
        } else if (isPdf) {
          const pdfjs = await import('pdfjs-dist');
          pdfjs.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjs.version}/pdf.worker.min.mjs`;
          
          const arrayBuffer = event.target?.result as ArrayBuffer;
          const pdf = await pdfjs.getDocument({ data: arrayBuffer }).promise;
          let fullText = '';
          
          for (let i = 1; i <= pdf.numPages; i++) {
            const page = await pdf.getPage(i);
            const textContent = await page.getTextContent();
            // eslint-disable-next-line @typescript-eslint/no-explicit-any
            const pageText = textContent.items.map((item: any) => item.str).join(' ');
            fullText += pageText + '\n';
          }
          
          const words = fullText.split(/[\s,]+/);
          rawMatrics = words.map(w => w.trim().toUpperCase().replace(/[^A-Z0-9/\-]/g, '')).filter(w => w.length > 5 && MATRIC_REGEX.test(w) && !w.includes('MATRIC'));
        } else {
          const csvText = event.target?.result as string;
          rawMatrics = csvText
            .split(/[\n,]+/)
            .map((m) => m.trim().toUpperCase().replace(/[^A-Z0-9/\-]/g, ''))
            .filter((m) => m.length > 5 && MATRIC_REGEX.test(m) && !m.includes('MATRIC'));
        }

        const uniqueMatrics = Array.from(new Set(rawMatrics));
        if (uniqueMatrics.length === 0) {
          addToast('Invalid file', 'No valid matric numbers found.', 'error');
          setIsUploadingList(false);
          e.target.value = '';
          return;
        }

        const headers = getStudentHeaders();
        const res = await fetch('/api/rep/upload-roster', {
          method: 'POST',
          headers,
          body: JSON.stringify({ courseId: repCourseId, matrics: uniqueMatrics })
        });

        const responseData = await res.json();

        if (res.ok) {
          addToast('Roster synced', `${uniqueMatrics.length} students synced.`, 'success');
          onRefresh();
        } else {
          addToast('Upload failed', responseData.error || 'Failed to sync roster.', 'error');
        }
      } catch (err) {
        console.error(err);
        addToast('File read error', 'Failed to read file.', 'error');
      } finally {
        setIsUploadingList(false);
        e.target.value = '';
      }
    };

    if (isExcel || isWord || isPdf) reader.readAsArrayBuffer(file);
    else reader.readAsText(file);
  };

  // HYBRID GPS LOGIC: Waits for the BEST possible ping, not just the first one
  const handleStartBackupSession = () => {
    if (!repCourseId) {
      addToast('No course selected', 'Select a course first.', 'error');
      return;
    }
    if (!navigator.geolocation) {
      addToast('GPS not supported', "Your phone doesn't support GPS.", 'error');
      return;
    }

    confirm.ask(
      `Start a backup session?`,
      'Your phone will become the GPS anchor for this class.',
      () => {
        setIsStartingRepSession(true);
        setRepSessionError('Getting the best GPS signal (up to 15s)...');

        let bestPos: GeolocationPosition | null = null;
        let bestAcc = Infinity;
        let watchId = 0;
        let finished = false;

        const cleanup = () => { if (watchId) navigator.geolocation.clearWatch(watchId); };

        const finish = async () => {
          if (finished) return;
          finished = true;
          cleanup();

          if (!bestPos) {
            setRepSessionError('Could not get any GPS signal. Step outside or near a window and try again.');
            setIsStartingRepSession(false);
            return;
          }

          try {
            const res = await fetch('/api/create-session', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                courseId: repCourseId,
                latitude: bestPos.coords.latitude,
                longitude: bestPos.coords.longitude,
                duration: repSessionDuration,
                checkinOpensAfter: 0,
                startedBy: 'Class Rep',
                repMatric: matricNumber,
              }),
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Failed to start session');

            addToast('Backup session started', 'Students can now check in.', 'success');
            onRefresh();
          } catch (err) {
            setRepSessionError(err instanceof Error ? err.message : 'Failed to start session.');
          } finally {
            setIsStartingRepSession(false);
          }
        };

        const timeoutId = setTimeout(finish, 15000);

        watchId = navigator.geolocation.watchPosition(
          (pos) => {
            if (finished) return;
            const acc = pos.coords.accuracy;
            
            if (acc < bestAcc) {
              bestAcc = acc;
              bestPos = pos;
              setRepSessionError(`Signal improving (±${Math.round(acc)}m)...`);
            }

            // If we get a really good ping (< 30m), stop waiting and go!
            if (acc <= 30) {
              clearTimeout(timeoutId);
              finish();
            }
          },
          () => {}, // Ignore individual errors, rely on the 15s timeout
          { enableHighAccuracy: true, maximumAge: 0, timeout: 15000 }
        );
      },
      { isDangerous: false, confirmLabel: 'Start Session' }
    );
  };

  const handleEndSession = async () => {
    if (!activeLiveSession) return;
    confirm.ask(
      'End Lecture?',
      'Students will no longer be able to check in. Are you sure?',
      async () => {
        setIsEndingSession(true);
        try {
          const headers = getStudentHeaders();
          await fetch('/api/end-session', { 
            method: 'POST', 
            headers,
            body: JSON.stringify({ sessionId: activeLiveSession.sessionId }) 
          });
          addToast('Session Ended', 'The lecture has been closed.', 'success');
          onRefresh();
        } catch {
          addToast('Error', 'Could not end session.', 'error');
        } finally {
          setIsEndingSession(false);
        }
      },
      { isDangerous: true, confirmLabel: 'End Lecture' }
    );
  };

  return (
    <div className="animate-in fade-in space-y-6">
      <div className="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 p-4 rounded-xl transition-colors">
        <h3 className="font-bold text-blue-900 dark:text-white text-base mb-2 flex items-center gap-2">
          <Upload size={18} /> Upload Class List
        </h3>
        <p className="text-sm text-blue-700 dark:text-blue-300 font-medium mb-3">
          Help the lecturer by uploading the roster for a course you represent.
        </p>

        <select
          aria-label="Course to Upload List"
          value={repCourseId}
          onChange={(e) => setRepCourseId(e.target.value)}
          className="w-full bg-white dark:bg-gray-800 border border-blue-200 dark:border-blue-700 text-gray-900 dark:text-white p-3 rounded-lg text-sm font-bold mb-3 outline-none"
        >
          {records?.map((r) => (
            <option key={r.id} value={r.id}>
              {r.course_code}
            </option>
          ))}
        </select>

        <label className="cursor-pointer flex items-center justify-center gap-2 w-full py-3 bg-white dark:bg-gray-800 border border-blue-300 dark:border-blue-700 rounded-xl font-bold text-sm text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-gray-700 transition-all shadow-sm">
          {isUploadingList ? <Clock size={18} className="animate-spin" /> : <FileText size={18} />}
          {isUploadingList ? 'Uploading...' : 'Select CSV / Excel / Word / PDF'}
          <input
            type="file"
            accept=".csv, .xlsx, .xls, .docx, .pdf"
            className="hidden"
            onChange={handleRepUpload}
            disabled={isUploadingList}
          />
        </label>
      </div>

      <div className="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-4 rounded-xl transition-colors">
        <h3 className="font-bold text-amber-900 dark:text-white text-base mb-2 flex items-center gap-2">
          <Zap size={18} /> Log Dead Battery
        </h3>
        <p className="text-sm text-amber-700 dark:text-amber-300 font-medium mb-3">
          If a student&apos;s phone died, log their matric number here. <strong>Limit: 3 per class.</strong>
        </p>

        <div className="flex gap-2">
          <input
            aria-label="Student Matric Number for Dead Battery"
            type="text"
            placeholder="Student's Matric No."
            value={repBatteryMatric}
            onChange={(e) => setRepBatteryMatric(e.target.value.toUpperCase())}
            className="w-full bg-white dark:bg-gray-800 border border-amber-200 dark:border-amber-700 text-gray-900 dark:text-white p-3 rounded-lg text-sm font-bold uppercase outline-none"
          />
          <button
            onClick={handleLogBattery}
            disabled={isLoggingBattery || !repBatteryMatric}
            className="bg-amber-500 text-white px-5 py-3 rounded-lg font-bold text-sm hover:bg-amber-600 disabled:opacity-50 whitespace-nowrap"
          >
            {isLoggingBattery ? 'Logging...' : 'Log'}
          </button>
        </div>
      </div>

      <div className="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-4 rounded-xl transition-colors">
        <h3 className="font-bold text-red-900 dark:text-white text-base mb-2 flex items-center gap-2">
          <PlayCircle size={18} /> Backup Anchor
        </h3>
        <p className="text-sm text-red-700 dark:text-red-300 font-medium mb-3">
          If the lecturer&apos;s phone is dead or missing, start a session from your phone.
        </p>

        {/* UPDATED UI: Always show the dropdown, conditionally show Start/End based on the selected course */}
        <div className="space-y-2">
          <div className="flex flex-col sm:flex-row gap-2">
            <select
              aria-label="Course for Backup Session"
              value={repCourseId}
              onChange={(e) => setRepCourseId(e.target.value)}
              className="w-full bg-white dark:bg-gray-800 border border-red-200 dark:border-red-700 text-gray-900 dark:text-white p-3 rounded-lg text-sm font-bold outline-none"
            >
              {records?.map((r) => (
                <option key={r.id} value={r.id}>
                  {r.course_code}
                </option>
              ))}
            </select>
            
            <div className="relative w-full sm:w-48">
              <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                <Timer size={16} />
              </div>
              <select
                aria-label="Duration"
                value={repSessionDuration}
                onChange={(e) => setRepSessionDuration(Number(e.target.value))}
                className="w-full bg-white dark:bg-gray-800 border border-red-200 dark:border-red-700 text-gray-900 dark:text-white p-3 pl-10 rounded-lg text-sm font-bold outline-none cursor-pointer"
              >
                <option value={15}>15 Mins</option>
                <option value={30}>30 Mins</option>
                <option value={60}>1 Hour</option>
                <option value={90}>1.5 Hours</option>
                <option value={120}>2 Hours</option>
              </select>
            </div>
          </div>

          {activeLiveSession && activeLiveSession.courseId === repCourseId ? (
            <div className="bg-white dark:bg-gray-800 border border-red-200 dark:border-red-800 p-3 rounded-lg text-center text-sm font-bold text-red-600 dark:text-red-400 mt-2">
              Session is currently active for this course.
              <button
                onClick={handleEndSession}
                disabled={isEndingSession}
                className="w-full mt-3 bg-red-600 text-white py-2.5 rounded-lg font-bold text-sm hover:bg-red-700 disabled:opacity-50 flex items-center justify-center gap-2"
              >
                {isEndingSession ? <Loader2 size={18} className="animate-spin" /> : <XCircle size={18} />}
                {isEndingSession ? 'Ending...' : 'End Active Session'}
              </button>
            </div>
          ) : (
            <button 
              onClick={handleStartBackupSession} 
              disabled={isStartingRepSession} 
              className="w-full bg-red-600 text-white py-3 rounded-lg font-bold text-sm hover:bg-red-700 disabled:opacity-50 flex items-center justify-center gap-2 mt-2"
            >
              {isStartingRepSession ? <Loader2 size={18} className="animate-spin" /> : <MapPin size={18} />}
              {isStartingRepSession ? 'Anchoring GPS...' : 'Start Backup Session'}
            </button>
          )}
          
          {repSessionError && <p className="text-xs text-red-600 dark:text-red-400 font-bold mt-2 text-center">{repSessionError}</p>}
        </div>
      </div>

      <ConfirmModal config={confirm.config} onClose={confirm.close} />
    </div>
  );
}
</file>

<file path="app/dashboard/courses/page.tsx">
'use client';
import { useState, useEffect, useCallback } from 'react';
import { supabase } from '@/utils/supabase';
import * as XLSX from 'xlsx';
import { ConfirmModal, useConfirmModal } from '@/components/ConfirmModal';
import FlagReview from '@/components/lecturer/FlagReview';
import {
  BookOpen, Users, Plus, Loader2, FileSpreadsheet, Trash2,
  Fingerprint, RefreshCw, UserPlus, Search, FileText,
  CheckCircle, AlertTriangle, ShieldCheck, Edit3, ChevronDown, X, Star
} from 'lucide-react';

interface Course {
  id: string;
  course_code: string;
  department: string;
  level: string;
  total_planned_classes: number;
  max_attendance_score: number;
  is_finalized: boolean;
  roster: string[] | null;
}

interface AuditRecord {
  sessionId: string;
  date: string;
  status: string;
  logId: string | null;
}

interface EnrollmentRow {
  course_id: string;
  matric_number: string;
}

interface SessionRow {
  session_id: string;
  created_at: string;
}

interface LogRow {
  id: string;
  session_id: string;
  status: string;
}

const DEPARTMENTS = ['CSC', 'MTH', 'PHY', 'CHM', 'BIO', 'ENG', 'LAW', 'MED', 'AGR', 'ECO'];
const LEVELS = ['100', '200', '300', '400', '500'];
const MATRIC_REGEX = /[\/\-]/;

export default function CourseManagement() {
  const [courses, setCourses] = useState<Course[]>([]);
  const [courseCounts, setCourseCounts] = useState<Record<string, number>>({});
  const [isLoading, setIsLoading] = useState(true);

  const [newCourseCode, setNewCourseCode] = useState('');
  const [newDept, setNewDept] = useState('');
  const [newLevel, setNewLevel] = useState('');
  const [plannedClasses, setPlannedClasses] = useState<number | ''>(15);
  const [maxScore, setMaxScore] = useState<number | ''>(10);
  const [isCreating, setIsCreating] = useState(false);

  const [uploadingId, setUploadingId] = useState<string | null>(null);
  const [actioningId, setActioningId] = useState<string | null>(null);

  const [editingCourse, setEditingCourse] = useState<Course | null>(null);
  const [editCode, setEditCode] = useState('');
  const [editPlanned, setEditPlanned] = useState<number | ''>(15);
  const [editMaxScore, setEditMaxScore] = useState<number | ''>(10);
  const [modalStudents, setModalStudents] = useState<string[]>([]);
  const [repMatric, setRepMatric] = useState<string | null>(null);
  const [isLoadingStudents, setIsLoadingStudents] = useState(false);

  const [repCourseId, setRepCourseId] = useState('');
  const [repMatricInput, setRepMatricInput] = useState('');
  const [isSettingRep, setIsSettingRep] = useState(false);

  const [singleMatric, setSingleMatric] = useState('');
  const [targetCourseId, setTargetCourseId] = useState('');
  const [isAddingSingle, setIsAddingSingle] = useState(false);

  const [auditMatric, setAuditMatric] = useState('');
  const [auditCourseId, setAuditCourseId] = useState('');
  const [isAuditing, setIsAuditing] = useState(false);
  const [auditRecords, setAuditRecords] = useState<AuditRecord[] | null>(null);

  const [wipeMatric, setWipeMatric] = useState('');
  const [isWiping, setIsWiping] = useState(false);

  const confirm = useConfirmModal();
  const askConfirmation = (title: string, message: string, onConfirm: () => void, isDangerous = true) => {
    confirm.ask(title, message, onConfirm, { isDangerous });
  };

  const getHeaders = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    return {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${session?.access_token || ''}`
    };
  };

  const fetchEnrollmentCounts = useCallback(async (courseIds: string[]) => {
    if (courseIds.length === 0) {
      setCourseCounts({});
      return;
    }
    const { data, error } = await supabase
      .from('enrollments')
      .select('course_id')
      .in('course_id', courseIds);

    if (error || !data) return;

    const counts: Record<string, number> = {};
    (data as EnrollmentRow[]).forEach(row => {
      counts[row.course_id] = (counts[row.course_id] || 0) + 1;
    });
    setCourseCounts(counts);
  }, []);

  const fetchCourses = useCallback(async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      setIsLoading(false);
      return;
    }

    const { data } = await supabase
      .from('courses')
      .select('*')
      .eq('lecturer_id', session.user.id)
      .order('created_at', { ascending: false });

    if (data) {
      setCourses(data);
      if (data.length > 0) {
        setTargetCourseId(prev => prev || data[0].id);
        setRepCourseId(prev => prev || data[0].id);
        setAuditCourseId(prev => prev || data[0].id);
        await fetchEnrollmentCounts(data.map(c => c.id));
      }
    }
    setIsLoading(false);
  }, [fetchEnrollmentCounts]);

  useEffect(() => {
    const id = setTimeout(() => { fetchCourses(); }, 0);
    return () => clearTimeout(id);
  }, [fetchCourses]);

  const createCourse = async () => {
    if (!newCourseCode.trim() || !plannedClasses || !maxScore || !newDept || !newLevel) return;
    setIsCreating(true);
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      const { error } = await supabase.from('courses').insert([{
        lecturer_id: session.user.id,
        course_code: newCourseCode.toUpperCase(),
        department: newDept,
        level: newLevel,
        total_planned_classes: Number(plannedClasses),
        max_attendance_score: Number(maxScore),
        roster: [],
      }]);
      if (!error) {
        setNewCourseCode('');
        setPlannedClasses(15);
        setMaxScore(10);
        setNewDept('');
        setNewLevel('');
        await fetchCourses();
      } else {
        confirm.ask('Error', 'Failed to create course.', () => {}, { isDangerous: false });
      }
    }
    setIsCreating(false);
  };

  const handleQuickSetRep = async () => {
    const cleanMatric = repMatricInput.trim().toUpperCase();
    if (!cleanMatric || !repCourseId) return;
    setIsSettingRep(true);
    try {
      const headers = await getHeaders();
      const res = await fetch('/api/set-rep', {
        method: 'POST',
        headers,
        body: JSON.stringify({ courseId: repCourseId, matricNumber: cleanMatric })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to set rep.");
      confirm.ask('Success', `✅ Success! ${cleanMatric} is now the Class Rep for this course.`, () => {}, { isDangerous: false });
      setRepMatricInput('');
    } catch (err) {
      confirm.ask('Error', err instanceof Error ? err.message : "Failed to set rep.", () => {}, { isDangerous: false });
    } finally {
      setIsSettingRep(false);
    }
  };

  const handleOpenModal = async (course: Course) => {
    setEditingCourse(course);
    setEditCode(course.course_code);
    setEditPlanned(course.total_planned_classes || 15);
    setEditMaxScore(course.max_attendance_score || 10);
    setIsLoadingStudents(true);
    setModalStudents([]);
    setRepMatric(null);

    const { data, error } = await supabase
      .from('enrollments')
      .select('matric_number')
      .eq('course_id', course.id)
      .order('matric_number');
      
    if (!error && data) {
      const matrics = data.map(d => d.matric_number);
      setModalStudents(matrics);

      if (matrics.length > 0) {
        const { data: reps } = await supabase
          .from('course_reps')
          .select('matric_number')
          .eq('course_id', course.id)
          .maybeSingle();
        if (reps) setRepMatric(reps.matric_number);
      }
    }
    setIsLoadingStudents(false);
  };

  const handleSaveModal = async () => {
    if (!editingCourse || !editCode.trim() || !editPlanned || !editMaxScore) return;
    
    setActioningId(editingCourse.id);
    const { error } = await supabase
      .from('courses')
      .update({ 
        course_code: editCode.toUpperCase().trim(),
        total_planned_classes: Number(editPlanned),
        max_attendance_score: Number(editMaxScore)
      })
      .eq('id', editingCourse.id);
      
    if (error) {
      confirm.ask('Error', `Failed to update course: ${error.message}`, () => {}, { isDangerous: false });
    } else {
      await fetchCourses();
      setEditingCourse(null);
    }
    setActioningId(null);
  };

  const handleDeleteCourse = (courseId: string, courseCode: string) => {
    askConfirmation(
      `Delete ${courseCode}?`,
      "WARNING: This will permanently delete all enrollments, sessions, and attendance logs tied to this course. This cannot be undone.",
      async () => {
        setActioningId(courseId);
        const { error } = await supabase.from('courses').delete().eq('id', courseId);
        if (error) {
          confirm.ask('Error', `Failed to delete course: ${error.message}`, () => {}, { isDangerous: false });
        } else {
          await fetchCourses();
        }
        setActioningId(null);
      }
    );
  };

  const handleRemoveStudent = (matric: string) => {
    if (!editingCourse) return;
    askConfirmation(
      `Remove ${matric}?`,
      "Their past attendance logs will not be deleted, but they will no longer be able to check in to this course.",
      async () => {
        const { error } = await supabase
          .from('enrollments')
          .delete()
          .eq('course_id', editingCourse.id)
          .eq('matric_number', matric);

        if (error) {
          confirm.ask('Error', 'Failed to remove student.', () => {}, { isDangerous: false });
        } else {
          setModalStudents(prev => prev.filter(m => m !== matric));
          if (repMatric === matric) setRepMatric(null);
          fetchEnrollmentCounts(courses.map(c => c.id));
        }
      }
    );
  };

  const handleFileUpload = async (e: React.ChangeEvent<HTMLInputElement>, courseId: string) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setUploadingId(courseId);

    const isExcel = file.name.endsWith('.xlsx') || file.name.endsWith('.xls');
    const isWord = file.name.endsWith('.docx');
    const isPdf = file.name.endsWith('.pdf');
    const reader = new FileReader();

    reader.onload = async (event) => {
      try {
        let rawMatrics: string[] = [];

        if (isExcel) {
          const data = new Uint8Array(event.target?.result as ArrayBuffer);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
          const jsonData = XLSX.utils.sheet_to_json(firstSheet, { header: 1 }) as string[][];
          
          jsonData.forEach(row => {
            row.forEach(cell => {
               if (typeof cell === 'string' && cell.length > 5 && MATRIC_REGEX.test(cell) && !cell.includes('MATRIC')) {
                 rawMatrics.push(cell.trim().toUpperCase().replace(/[^A-Z0-9/\-]/g, ''));
               }
            });
          });
        } else if (isWord) {
          const mammoth = await import('mammoth');
          const arrayBuffer = event.target?.result as ArrayBuffer;
          const result = await mammoth.extractRawText({ arrayBuffer });
          const words = result.value.split(/[\s,]+/);
          rawMatrics = words
            .map(w => w.trim().toUpperCase().replace(/[^A-Z0-9/\-]/g, ''))
            .filter(w => w.length > 5 && MATRIC_REGEX.test(w) && !w.includes('MATRIC'));
        } else if (isPdf) {
          const pdfjs = await import('pdfjs-dist');
          // Use https and .mjs to prevent Vercel CSP errors
          pdfjs.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjs.version}/pdf.worker.min.mjs`;
          
          const arrayBuffer = event.target?.result as ArrayBuffer;
          const pdf = await pdfjs.getDocument({ data: arrayBuffer }).promise;
          let fullText = '';
          
          for (let i = 1; i <= pdf.numPages; i++) {
            const page = await pdf.getPage(i);
            const textContent = await page.getTextContent();
            // eslint-disable-next-line @typescript-eslint/no-explicit-any
            const pageText = textContent.items.map((item: any) => item.str).join(' ');
            fullText += pageText + '\n';
          }
          
          const words = fullText.split(/[\s,]+/);
          rawMatrics = words
            .map(w => w.trim().toUpperCase().replace(/[^A-Z0-9/\-]/g, ''))
            .filter(w => w.length > 5 && MATRIC_REGEX.test(w) && !w.includes('MATRIC'));
        } else {
          const csvText = event.target?.result as string;
          rawMatrics = csvText
            .split(/[\n,]+/)
            .map(m => m.trim().toUpperCase().replace(/[^A-Z0-9/\-]/g, ''))
            .filter(m => m.length > 5 && MATRIC_REGEX.test(m) && !m.includes('MATRIC'));
        }

        const uniqueMatrics = Array.from(new Set(rawMatrics));
        
        if (uniqueMatrics.length === 0) {
          confirm.ask('Invalid File', 'No valid matric numbers found. If this is a scanned PDF, please use an Excel or CSV file.', () => {}, { isDangerous: false });
          setUploadingId(null);
          e.target.value = '';
          return;
        }

        if (uniqueMatrics.length > 5000) {
          confirm.ask('File Too Large', 'Maximum 5,000 students per upload.', () => {}, { isDangerous: false });
          setUploadingId(null);
          e.target.value = '';
          return;
        }

        const rows = uniqueMatrics.map(matric => ({
          course_id: courseId,
          matric_number: matric,
        }));

        const { error } = await supabase
          .from('enrollments')
          .upsert(rows, { onConflict: 'course_id,matric_number', ignoreDuplicates: true });

        if (!error) {
          confirm.ask('Success', `Success! ${uniqueMatrics.length} students synced.`, () => {}, { isDangerous: false });
          await fetchCourses();
          if (editingCourse?.id === courseId) handleOpenModal(editingCourse);
        } else {
          confirm.ask('Error', `Upload failed: ${error.message}`, () => {}, { isDangerous: false });
        }
      } catch (err) {
        console.error(err);
        confirm.ask('Error', 'Failed to read file. Make sure it is a valid CSV, Excel, Word, or Text-based PDF.', () => {}, { isDangerous: false });
      }
      
      setUploadingId(null);
      e.target.value = '';
    };
    
    if (isExcel || isWord || isPdf) {
      reader.readAsArrayBuffer(file);
    } else {
      reader.readAsText(file);
    }
  };

  const handleSingleStudentAdd = async () => {
    const cleanMatric = singleMatric.trim().toUpperCase();
    if (!cleanMatric || !targetCourseId) return;
    setIsAddingSingle(true);

    const { error } = await supabase
      .from('enrollments')
      .upsert(
        { course_id: targetCourseId, matric_number: cleanMatric },
        { onConflict: 'course_id,matric_number', ignoreDuplicates: true }
      );

    if (!error) {
      confirm.ask('Success', `${cleanMatric} added successfully!`, () => {}, { isDangerous: false });
      setSingleMatric('');
      await fetchCourses();
    } else {
      confirm.ask('Error', `Failed to add student: ${error.message}`, () => {}, { isDangerous: false });
    }
    setIsAddingSingle(false);
  };

  const handleStudentAudit = useCallback(async () => {
    const cleanMatric = auditMatric.trim().toUpperCase();
    if (!cleanMatric || !auditCourseId) return;
    setIsAuditing(true);
    setAuditRecords(null);

    try {
      const { data: sessions } = await supabase
        .from('lecture_sessions')
        .select('session_id, created_at')
        .eq('course_id', auditCourseId)
        .order('created_at', { ascending: false });

      if (!sessions || sessions.length === 0) throw new Error("No classes held yet.");

      const sessionIds = (sessions as SessionRow[]).map(s => s.session_id);

      const { data: logs } = await supabase
        .from('attendance_logs')
        .select('id, session_id, status')
        .eq('matric_number', cleanMatric)
        .in('session_id', sessionIds);

      const logMap = new Map<string, LogRow>(
        ((logs as LogRow[] | null) || []).map(l => [l.session_id, l])
      );

      const trail: AuditRecord[] = (sessions as SessionRow[]).map(session => {
        const log = logMap.get(session.session_id);
        return {
          sessionId: session.session_id,
          date: new Date(session.created_at).toLocaleDateString() + ' ' +
                new Date(session.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          status: log ? log.status : 'absent',
          logId: log ? log.id : null,
        };
      });

      setAuditRecords(trail);
    } catch (e) {
      const msg = e instanceof Error ? e.message : "Audit failed.";
      confirm.ask('Audit Failed', msg, () => {}, { isDangerous: false });
    }
    setIsAuditing(false);
  }, [auditMatric, auditCourseId, confirm]);

  const grantMedicalWaiver = async (record: AuditRecord) => {
    const cleanMatric = auditMatric.trim().toUpperCase();
    
    askConfirmation(
      `Grant Waiver?`,
      `Grant Medical/Excused Waiver for ${cleanMatric} on ${record.date}? This will count them as present.`,
      async () => {
        try {
          const headers = await getHeaders();
          const res = await fetch('/api/override-attendance', {
            method: 'POST',
            headers,
            body: JSON.stringify({ sessionId: record.sessionId, matricNumber: cleanMatric })
          });

          if (!res.ok) throw new Error("Failed to grant waiver");

          confirm.ask('Success', 'Waiver Granted successfully!', () => {}, { isDangerous: false });
          handleStudentAudit();
        } catch {
          confirm.ask('Error', 'Failed to grant waiver.', () => {}, { isDangerous: false });
        }
      },
      false
    );
  };

  const handleDeviceReset = async () => {
    const safeMatric = String(wipeMatric || "").trim();
    if (!safeMatric) return;
    
    askConfirmation(
      `Wipe device lock for ${safeMatric}?`,
      "They will need to re-register their biometrics on a new phone. Their attendance history will remain intact.",
      async () => {
        setIsWiping(true);
        try {
          const headers = await getHeaders();
          const response = await fetch('/api/reset-device', {
            method: 'POST',
            headers,
            body: JSON.stringify({ matricNumber: safeMatric }),
          });
          if (response.ok) {
            confirm.ask('Success', `✅ Hardware binding completely wiped for ${safeMatric}.`, () => {}, { isDangerous: false });
            setWipeMatric('');
          } else {
            confirm.ask('Error', '⚠️ Failed to wipe device.', () => {}, { isDangerous: false });
          }
        } catch {
          confirm.ask('Error', '💥 Network Error.', () => {}, { isDangerous: false });
        } finally {
          setIsWiping(false);
        }
      }
    );
  };

  if (isLoading) {
    return (
      <div className="flex justify-center py-20">
        <Loader2 className="w-10 h-10 text-[#2563EB] dark:text-blue-400 animate-spin" />
      </div>
    );
  }  return (
    <div className="p-4 md:p-8 max-w-6xl mx-auto space-y-6 bg-gray-50 dark:bg-gray-950 min-h-screen transition-colors duration-300">

      <div className="bg-white dark:bg-gray-900 p-6 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 transition-colors">
        <h1 className="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight flex items-center gap-3">
          <Users className="text-[#2563EB] dark:text-blue-400" size={28} /> Course & Student Management
        </h1>
        <p className="text-gray-500 dark:text-gray-400 mt-1 font-medium">
          Manage course rosters, grant medical waivers, and wipe device locks.
        </p>
      </div>

      {/* SECTION 1: COURSE REGISTRY */}
      <div className="bg-white dark:bg-gray-900 p-6 md:p-8 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 transition-colors">
        <div className="flex items-center gap-2 mb-8 border-b border-gray-100 dark:border-gray-800 pb-4">
          <BookOpen className="text-[#2563EB] dark:text-blue-400" size={24}/>
          <h2 className="text-xl font-extrabold text-gray-900 dark:text-white">Course Registry & Rosters</h2>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          {/* LEFT COLUMN: Create Course */}
          <div className="lg:col-span-7 space-y-4">
            <div className="flex items-center gap-2">
              <div className="bg-blue-100 dark:bg-blue-900/40 text-[#2563EB] dark:text-blue-400 w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold">1</div>
              <h3 className="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider">Establish New Course</h3>
            </div>
            
            <div className="space-y-4 bg-gray-50 dark:bg-gray-800/50 p-6 rounded-2xl border border-gray-100 dark:border-gray-800">
              <div>
                <label className="block text-xs font-bold text-gray-600 dark:text-gray-400 mb-1 ml-1">Course Code</label>
                <input
                  aria-label="Course Code"
                  type="text"
                  placeholder="e.g., CSC 301"
                  value={newCourseCode}
                  onChange={(e) => setNewCourseCode(e.target.value)}
                  className="w-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl outline-none font-bold text-gray-900 dark:text-white placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:ring-2 focus:ring-[#2563EB] uppercase transition-all"
                />
              </div>
              
