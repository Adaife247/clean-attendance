                                                            </button>
                                                        </div>
                                                    ))}
                                                </div>
                                            )}
                                        </div>
                                    </>
                                )}
                            </div>
                        )}

                        {/* ANALYTICS TAB */}
                        {activeTab === 'analytics' && (
                            <div className="fade-in space-y-4">
                                <div className="bg-white p-5 rounded-2xl shadow-sm border border-gray-200">
