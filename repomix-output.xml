                                        <h2 className="text-lg font-black text-gray-900">{editingCourse.code}</h2>
                                        <p className="text-[10px] font-bold text-gray-500 uppercase">{editingCourse.dept} • {editingCourse.level}L</p>
                                    </div>
                                    <button onClick={() => setEditingCourse(null)} className="p-2 bg-white rounded-full text-gray-400 shadow-sm border border-gray-200"><i data-lucide="x" className="w-4 h-4"></i></button>
                                </div>
                                <div className="p-4 overflow-y-auto space-y-4 flex-1">
                                    <h3 className="text-xs font-bold text-gray-800 border-b border-gray-100 pb-2">Enrolled Students</h3>
