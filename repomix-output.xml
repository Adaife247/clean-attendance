  const [data, setData] = useState<DashboardData | null>(null);

  const [sessionDuration, setSessionDuration] = useState<number>(60);
  const [checkinOpensAfter, setCheckinOpensAfter] = useState<number>(10);
  
  const [timeLeft, setTimeLeft] = useState<string | null>(null);

  const [manualMatric, setManualMatric] = useState('');
  const [isOverriding, setIsOverriding] = useState(false);
  const [isResetting, setIsResetting] = useState(false);

  const [viewMode, setViewMode] = useState<'live' | 'history'>('live');
  const [ledgerTab, setLedgerTab] = useState<'verified' | 'flagged'>('verified');
  
  const [pastSessions, setPastSessions] = useState<PastSession[]>([]);
  const [historySearch, setHistorySearch] = useState('');
  const [viewingPastSession, setViewingPastSession] = useState<PastSession | null>(null);
  const [pastSessionLogs, setPastSessionLogs] = useState<Log[]>([]);
  const [downloadingId, setDownloadingId] = useState<string | null>(null);

  const [isOnline, setIsOnline] = useState(true);
  const [isSlowNetwork, setIsSlowNetwork] = useState(false);

  const prewarmWatchRef = useRef<number | null>(null);
  const prewarmPosRef = useRef<{ lat: number; lng: number; acc: number; ts: number } | null>(null);
  const isFetchingRef = useRef(false);

  const confirm = useConfirmModal();

  const getHeaders = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    return {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${session?.access_token || ''}`
    };
  };

  useEffect(() => {
    const handleOnline = () => setIsOnline(true);
    const handleOffline = () => setIsOnline(false);
    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);
    
    const initCheck = setTimeout(() => setIsOnline(navigator.onLine), 0);

    const checkLatency = async () => {
      const start = Date.now();
      try {
        await fetch('/api/health', { method: 'GET', cache: 'no-store' });
        const latency = Date.now() - start;
        setTimeout(() => setIsSlowNetwork(latency > 2000), 0);
      } catch {
        setTimeout(() => setIsSlowNetwork(true), 0);
      }
    };
    const latencyTimeout = setTimeout(checkLatency, 1000);

    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
      clearTimeout(initCheck);
      clearTimeout(latencyTimeout);
    };
  }, []);

  const clearStaleSession = useCallback((reason?: string) => {
    localStorage.removeItem(ACTIVE_SESSION_KEY);
    setActiveSessionId(null);
    setData(null);
    setSetupError('');
    setTimeLeft(null);
    if (reason) setExpiredMessage(reason);
  }, []);

  useEffect(() => {
    const securePageAndFetchProfile = async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { router.push('/login'); return; }
      
      const { data: profileData } = await supabase.from('lecturers').select('full_name, department').eq('id', session.user.id).single();
      if (profileData) setProfile({ full_name: profileData.full_name, department: profileData.department });

      const { data: courseData } = await supabase.from('courses').select('id, course_code, department, level').eq('lecturer_id', session.user.id).order('created_at', { ascending: false });
      
      if (courseData && courseData.length > 0) {
        setCourses(courseData);
        setSelectedCourseId(prev => prev || courseData[0].id);

        const courseIds = courseData.map(c => c.id);
        const { data: activeSession } = await supabase
          .from('lecture_sessions')
          .select('session_id')
          .in('course_id', courseIds)
          .eq('is_active', true)
          .gt('expires_at', new Date().toISOString())
          .order('created_at', { ascending: false })
          .limit(1)
          .maybeSingle();

        if (activeSession) {
          localStorage.setItem(ACTIVE_SESSION_KEY, activeSession.session_id);
          setActiveSessionId(activeSession.session_id);
        }
      }
    };
    const id = setTimeout(() => { securePageAndFetchProfile(); }, 0);
    return () => clearTimeout(id);
  }, [router]);

  useEffect(() => {
    const timeoutId = window.setTimeout(async () => {
      const savedSession = localStorage.getItem(ACTIVE_SESSION_KEY);
      if (!savedSession) return;

      const { data } = await supabase.from('lecture_sessions').select('is_active, expires_at').eq('session_id', savedSession).single();

      if (!data) {
        localStorage.removeItem(ACTIVE_SESSION_KEY);
        return;
      }

      const isExpired = data.expires_at && new Date(data.expires_at).getTime() < Date.now();

      if (data.is_active && !isExpired) {
        setActiveSessionId(savedSession);
      } else {
        localStorage.removeItem(ACTIVE_SESSION_KEY);
        if (isExpired) setExpiredMessage('The previous session expired while you were away.');
      }
    }, 0);
    return () => window.clearTimeout(timeoutId);
  }, []);

  useEffect(() => {
    if (!activeSessionId) return;

    const checkExpiry = async () => {
      const { data } = await supabase.from('lecture_sessions').select('is_active, expires_at').eq('session_id', activeSessionId).single();

      if (!data) {
        clearStaleSession('This session no longer exists.');
        return;
      }

      const isExpired = data.expires_at && new Date(data.expires_at).getTime() < Date.now();
      const isManuallyEnded = !data.is_active;

      if (isExpired || isManuallyEnded) {
        clearStaleSession(isManuallyEnded ? 'This session was ended.' : 'Time is up. The session expired.');
      }
    };

    const intervalId = setInterval(checkExpiry, SESSION_EXPIRY_POLL_MS);
    return () => clearInterval(intervalId);
  }, [activeSessionId, clearStaleSession]);

  useEffect(() => {
    if (!activeSessionId) {
      const id = setTimeout(() => setTimeLeft(null), 0);
      return () => clearTimeout(id);
    }

    const fetchExpiry = async () => {
      const { data: session } = await supabase.from('lecture_sessions').select('expires_at').eq('session_id', activeSessionId).single();
      if (session?.expires_at) {
        const msLeft = new Date(session.expires_at).getTime() - Date.now();
        if (msLeft > 0) {
          const mins = Math.floor(msLeft / 60000);
          const secs = Math.floor((msLeft % 60000) / 1000);
          setTimeLeft(`${mins}m ${secs}s`);
        } else {
          setTimeLeft("Expired");
        }
      }
    };

    const initialFetchId = setTimeout(() => { fetchExpiry(); }, 0);
    const interval = setInterval(fetchExpiry, 10000);
    
    return () => {
      clearTimeout(initialFetchId);
      clearInterval(interval);
    };
  }, [activeSessionId]);

  useEffect(() => {
    if (typeof navigator === 'undefined' || !navigator.geolocation) return;
    const id = navigator.geolocation.watchPosition(
      (position) => { prewarmPosRef.current = { lat: position.coords.latitude, lng: position.coords.longitude, acc: position.coords.accuracy, ts: Date.now() }; },
      () => {},
      { enableHighAccuracy: true, maximumAge: 0, timeout: 30000 }
    );
    prewarmWatchRef.current = id;
    return () => { if (prewarmWatchRef.current !== null) navigator.geolocation.clearWatch(prewarmWatchRef.current); };
  }, []);

  const loadHistory = useCallback(async () => {
    const course = courses.find(c => c.id === selectedCourseId);
    if (!course) return;
    try {
      const headers = await getHeaders();
      const response = await fetch(`/api/attendance-history?courseId=${course.id}`, { headers });
      if (response.ok) setPastSessions(await response.json());
      else if (response.status === 401) router.push('/login');
    } catch { 
      console.error("Failed to load history"); 
    }
  }, [courses, selectedCourseId, router]);

  useEffect(() => {
    if (viewMode !== 'history') return;
    const id = setTimeout(() => { loadHistory(); }, 0);
    return () => clearTimeout(id);
  }, [viewMode, loadHistory]);

  // HYBRID GPS LOGIC FOR LECTURER
  const startNewSession = () => {
    if (!selectedCourseId) { setSetupError("Please register a course first."); return; }
    setIsStarting(true);
    setSetupError("");
    setExpiredMessage('');
    if (!navigator.geolocation) { setSetupError("Location services not supported by your browser."); setIsStarting(false); return; }

    const executeSessionCreation = async (lat: number, lng: number) => {
      setSetupError("Creating session...");
      try {
        const headers = await getHeaders();
        const response = await fetch('/api/create-session', {
          method: 'POST', 
          headers,
          body: JSON.stringify({ courseId: selectedCourseId, latitude: lat, longitude: lng, duration: sessionDuration, checkinOpensAfter, startedBy: 'lecturer' })
        });
        if (response.ok) {
          const result = await response.json();
          localStorage.setItem(ACTIVE_SESSION_KEY, result.sessionId);
          try { localStorage.setItem(ANCHOR_CACHE_KEY, JSON.stringify({ lat, lng, ts: Date.now() })); } catch {}
          setActiveSessionId(result.sessionId);
          setViewMode('live');
        } else if (response.status === 401) {
          router.push('/login');
        } else { 
          const errData = await response.json().catch(() => ({}));
          setSetupError(errData.error || "Failed to create session on server."); 
        }
      } catch { 
        setSetupError("Network error. Please try again."); 
      } finally { 
        setIsStarting(false); 
      }
    };

    try {
      const cached = localStorage.getItem(ANCHOR_CACHE_KEY);
      if (cached) {
        const parsed = JSON.parse(cached) as { lat: number; lng: number; ts: number };
        if (Date.now() - parsed.ts < ANCHOR_CACHE_MAX_AGE_MS) {
          setSetupError("Using cached location..."); 
          executeSessionCreation(parsed.lat, parsed.lng); 
          return;
        }
      }
    } catch {}

    if (prewarmPosRef.current && Date.now() - prewarmPosRef.current.ts < 15000) {
      const snapshot = prewarmPosRef.current;
      setSetupError(`Using recent fix (±${Math.round(snapshot.acc)}m)...`);
      executeSessionCreation(snapshot.lat, snapshot.lng); 
      return;
    }

    setSetupError("Getting the best GPS signal (up to 15s)...");
    
    let bestPos: GeolocationPosition | null = null;
    let bestAcc = Infinity;
    let watchId = 0;
    let finished = false;

    const cleanup = () => { if (watchId) navigator.geolocation.clearWatch(watchId); };

    const finish = () => {
      if (finished) return;
      finished = true;
      cleanup();

      if (!bestPos) {
        setSetupError("Could not get any GPS signal. Step outside or near a window and try again.");
        setIsStarting(false);
        return;
      }

      executeSessionCreation(bestPos.coords.latitude, bestPos.coords.longitude);
    };

    const timeoutId = setTimeout(finish, 15000);

    watchId = navigator.geolocation.watchPosition(
      (pos) => {
        if (finished) return;
        const acc = pos.coords.accuracy;
        
        if (acc < bestAcc) {
          bestAcc = acc;
          bestPos = pos;
          setSetupError(`Signal improving (±${Math.round(acc)}m)...`);
        }

        if (acc <= 30) {
          clearTimeout(timeoutId);
          finish();
        }
      },
      () => {},
      { enableHighAccuracy: true, maximumAge: 0, timeout: 15000 }
    );
  };

  const updateGeofence = async () => {
    if (!activeSessionId) return;
    
    confirm.ask(
      'Update Geofence?',
      'Update the class anchor to your current location? Stand in the middle of the lecture hall first.',
      async () => {
        setIsUpdatingGeofence(true);
        try {
          if (!navigator.geolocation) throw new Error("No geolocation support");
          
          navigator.geolocation.getCurrentPosition(
            async (position) => {
              const acc = position.coords.accuracy;
              if (acc > 50) {
                confirm.ask('GPS Too Weak', `Your current accuracy is ±${Math.round(acc)}m. Move near a window or outdoors, then try again.`, () => {}, { isDangerous: false });
                setIsUpdatingGeofence(false);
                return;
              }

              const { error } = await supabase
                .from('lecture_sessions')
                .update({ anchor_latitude: position.coords.latitude, anchor_longitude: position.coords.longitude })
                .eq('session_id', activeSessionId);
                
              if (error) {
                confirm.ask('Error', 'Failed to update geofence.', () => {}, { isDangerous: false });
              } else {
                try { localStorage.setItem(ANCHOR_CACHE_KEY, JSON.stringify({ lat: position.coords.latitude, lng: position.coords.longitude, ts: Date.now() })); } catch {}
                confirm.ask('Success', `Geofence updated (±${Math.round(acc)}m accuracy).`, () => {}, { isDangerous: false });
              }
              setIsUpdatingGeofence(false);
            },
            () => {
              confirm.ask('Error', 'Could not get your GPS location. Ensure location is on.', () => {}, { isDangerous: false });
              setIsUpdatingGeofence(false);
            },
            { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
          );
        } catch {
          confirm.ask('Error', 'Error updating location.', () => {}, { isDangerous: false });
          setIsUpdatingGeofence(false);
        }
      },
      { isDangerous: false, confirmLabel: 'Update GPS' }
    );
  };

  const endSession = () => {
    if (!activeSessionId) return;
    confirm.ask(
      'End this lecture?',
      'Students will no longer be able to check in. This cannot be undone.',
      async () => {
        try {
          const headers = await getHeaders();
          await fetch('/api/end-session', { method: 'POST', headers, body: JSON.stringify({ sessionId: activeSessionId }) });
        } catch (err) {
          console.error('Failed to notify server', err);
        }
        clearStaleSession('Session ended. Ready for the next one.');
      },
      { isDangerous: true, confirmLabel: 'End Lecture' }
    );
  };

  const fetchDashboardData = useCallback(async () => {
    if (!activeSessionId || isFetchingRef.current) return;
    
    isFetchingRef.current = true;
    try {
      const headers = await getHeaders();
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const response = await fetch(`/api/dashboard-data?sessionId=${activeSessionId}&timeZone=${encodeURIComponent(tz)}`, { headers });
      if (response.ok) { 
        setData(await response.json()); 
      } else if (response.status === 401) {
        router.push('/login');
      }
    } catch { 
      console.error("Failed to fetch data"); 
    } finally {
      isFetchingRef.current = false;
    }
  }, [activeSessionId, router]);

  useEffect(() => {
    if (!activeSessionId || viewMode !== 'live') return;
    const immediateId = setTimeout(() => { fetchDashboardData(); }, 0);
    
    const channel = supabase
      .channel(`attendance_${activeSessionId}`)
      .on('postgres_changes', { event: '*', schema: 'public', table: 'attendance_logs', filter: `session_id=eq.${activeSessionId}` }, () => { fetchDashboardData(); })
      .subscribe();

    const interval = setInterval(fetchDashboardData, 10000);

    return () => {
      clearTimeout(immediateId);
      clearInterval(interval);
      supabase.removeChannel(channel);
    };
  }, [activeSessionId, viewMode, fetchDashboardData]);

  const handleManualOverride = async (targetMatric: string) => {
    const safeMatric = String(targetMatric || '').trim();
    if (!activeSessionId || !safeMatric) return;

    setIsOverriding(true);
    try {
      const headers = await getHeaders();
      const response = await fetch('/api/override-attendance', {
        method: 'POST', headers,
        body: JSON.stringify({ sessionId: activeSessionId, matricNumber: safeMatric }),
      });
      if (response.ok) {
        setManualMatric('');
        fetchDashboardData();
      } else if (response.status === 401) {
        router.push('/login');
      }
    } catch (err) {
      console.error(err);
    } finally {
      setIsOverriding(false);
    }
  };

  const handleDeviceReset = (targetMatric: string) => {
    const safeMatric = String(targetMatric || '').trim();
    if (!safeMatric) return;

    confirm.ask(
      `Wipe device lock for ${safeMatric}?`,
      'They will need to re-register their biometrics on a new phone. Their attendance history will remain intact.',
      async () => {
        setIsResetting(true);
        try {
          const headers = await getHeaders();
          const response = await fetch('/api/reset-device', { method: 'POST', headers, body: JSON.stringify({ matricNumber: safeMatric }) });
          if (response.ok) setManualMatric('');
        } catch (err) {
          console.error(err);
        } finally {
          setIsResetting(false);
        }
      }
    );
  };

  const generateAndDownloadCSV = (logsToExport: Log[], courseName: string, dateStr: string, isArchive: boolean) => {
    if (!logsToExport || logsToExport.length === 0) return;
    const verifiedCount = logsToExport.filter(l => l.status === 'verified').length;

    const sanitize = (val: string | number) => {
      const str = String(val);
      if (/^[=+\-@]/.test(str)) return `'${str}`;
      return str;
    };

    const header = [
      [`OFFICIAL ATTENDANCE REPORT ${isArchive ? '(ARCHIVED)' : ''}`],
      ["Course Code", sanitize(courseName)], ["Date Generated", dateStr],
      ["Total Present", verifiedCount], ["Total Records Logged", logsToExport.length], [],
      ["Matric Number", "Status", "Timestamp", "Security Flag"]
    ];
    const rows = logsToExport.sort((a, b) => a.matricNumber.localeCompare(b.matricNumber))
      .map(log => {
        const flag = log.status === 'verified' ? 'Verified' 
          : log.status === 'pending_override' ? 'Raised Hand / Waiver Pending'
          : log.status === 'flagged' ? `Flagged: ${log.reason || 'Unknown'}`
          : log.status;
        return [ sanitize(log.matricNumber), sanitize(log.status.toUpperCase()), sanitize(log.time), sanitize(flag) ];
      });
      
    const csvContent = [...header, ...rows].map(row => row.join(",")).join("\n");
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.setAttribute("download", `${courseName.replace(/\s+/g, '_')}_Attendance_${dateStr.replace(/\//g, '-')}.csv`);
    document.body.appendChild(link); link.click(); document.body.removeChild(link);
  };

  const exportLiveCSV = () => { if (data) generateAndDownloadCSV(data.logs, data.course, new Date().toLocaleDateString(), false); };
  
  const downloadPastSession = async (sessionId: string, dateString: string, courseCode: string) => {
    setDownloadingId(sessionId);
    try {
      const headers = await getHeaders();
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const response = await fetch(`/api/dashboard-data?sessionId=${sessionId}&timeZone=${encodeURIComponent(tz)}`, { headers });
      if (!response.ok) throw new Error("Failed to fetch");
      const pastData = await response.json();
      generateAndDownloadCSV(pastData.logs, courseCode, dateString, true);
    } catch { 
      console.error("Download failed");
    }
    finally { setDownloadingId(null); }
  };

  const viewPastLedger = async (session: PastSession) => {
    setViewingPastSession(session);
    const headers = await getHeaders();
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const response = await fetch(`/api/dashboard-data?sessionId=${session.session_id}&timeZone=${encodeURIComponent(tz)}`, { headers });
    if (response.ok) {
      const result = await response.json();
      setPastSessionLogs(result.logs);
    }
  };

  const copySessionInfo = () => {
    const baseUrl = window.location.origin;
    const link = `${baseUrl}/?sessionId=${activeSessionId}`;
    const courseName = data?.course || 'Active Class';
    const clipboardText = `📌 *CampusCheck Attendance Link*\n\n📚 Class: ${courseName}\n⏱ Opens: ${checkinOpensAfter === 0 ? 'Immediately' : `In ${checkinOpensAfter} minutes`}\n\n🔗 ${link}\n\n_Open this link on your phone to check in. You must be inside the lecture hall._`;
    navigator.clipboard.writeText(clipboardText);
    confirm.ask('Link Copied', 'Attendance link copied! Share it with your students.', () => {}, { isDangerous: false });
  };

  const filteredHistory = pastSessions.filter(s => 
    s.course_code.toLowerCase().includes(historySearch.toLowerCase()) || 
    new Date(s.created_at).toLocaleString().toLowerCase().includes(historySearch.toLowerCase())
  );

  const getVelocityData = () => {
    if (!data || !data.logs) return [];
    const timeBuckets: Record<string, number> = {};
    data.logs.forEach(log => {
      timeBuckets[log.time] = (timeBuckets[log.time] || 0) + 1;
    });
    return Object.entries(timeBuckets)
      .sort(([timeA], [timeB]) => timeA.localeCompare(timeB))
      .map(([time, count]) => ({ time, count }));
  };
  const velocityData = getVelocityData();

  if (!activeSessionId || viewMode === 'history') {
    return (
      <div className="min-h-screen bg-[#F9FAFB] dark:bg-gray-950 p-4 md:p-8 font-sans transition-colors duration-300">
        <div className="max-w-4xl mx-auto h-175 overflow-y-auto pb-10">
          {expiredMessage && (
            <div className="mb-4 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-700/50 p-4 rounded-2xl flex items-start gap-3 animate-in fade-in slide-in-from-top-2">
              <AlertTriangle className="text-amber-600 dark:text-amber-500 shrink-0 mt-0.5" size={20} />
              <div className="flex-1">
                <p className="font-bold text-amber-900 dark:text-amber-200 text-sm">{expiredMessage}</p>
                <p className="text-xs text-amber-700 dark:text-amber-400 font-medium mt-1">Start a new session below, or review past records.</p>
              </div>
              <button onClick={() => setExpiredMessage('')} className="text-amber-600 dark:text-amber-500 hover:text-amber-800 dark:hover:text-amber-300 text-xs font-bold">Dismiss</button>
            </div>
          )}

          <div className="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 p-6 mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 transition-colors duration-300">
            <div>
              <h2 className="text-2xl font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
                {viewMode === 'history' ? <Archive className="text-[#2563EB] dark:text-blue-400" /> : <ShieldCheck className="text-[#2563EB] dark:text-blue-400" />}
                {viewMode === 'history' ? 'Vault Archive' : 'Start Lecture'}
              </h2>
              <p className="text-gray-500 dark:text-gray-400 font-medium mt-1">
                {viewMode === 'history' ? 'Review past session ledgers and download reports.' : `Welcome, ${profile?.full_name || 'Lecturer'}`}
              </p>
            </div>
            <div className="flex bg-gray-50 dark:bg-gray-800 p-1 rounded-xl w-full md:w-auto items-center transition-colors duration-300">
              <button onClick={() => { setViewMode('live'); setActiveSessionId(null); }} className={`flex-1 md:flex-none px-6 py-2 rounded-lg text-sm font-bold transition-all ${viewMode === 'live' ? 'bg-white dark:bg-gray-700 text-gray-900 dark:text-white shadow-sm border border-gray-200 dark:border-gray-600' : 'text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200'}`}>Start Class</button>
              <button onClick={() => { setViewMode('history'); setActiveSessionId('vault'); }} className={`flex-1 md:flex-none px-6 py-2 rounded-lg text-sm font-bold transition-all ${viewMode === 'history' ? 'bg-white dark:bg-gray-700 text-gray-900 dark:text-white shadow-sm border border-gray-200 dark:border-gray-600' : 'text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200'}`}>Past Records</button>
            </div>
          </div>

          {viewMode === 'live' ? (
            <div className="max-w-md mx-auto bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-gray-100 dark:border-gray-800 p-6 md:p-8 text-center animate-in fade-in slide-in-from-bottom-4 transition-colors duration-300">
              <div className="bg-[#2563EB] text-white w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-blue-500/30">
                <User size={40} strokeWidth={2.5} />
              </div>
              <h2 className="text-2xl font-extrabold text-gray-900 dark:text-white tracking-tight">Ready to start?</h2>
              
              {courses.length === 0 ? (
                <div className="text-center py-8 space-y-4 mt-6">
                  <div className="bg-blue-50 dark:bg-blue-900/30 p-4 rounded-full w-20 h-20 mx-auto flex items-center justify-center">
                    <BookOpen size={36} className="text-[#2563EB] dark:text-blue-400" />
                  </div>
                  <div>
                    <h3 className="text-lg font-bold text-gray-900 dark:text-white">No courses yet</h3>
                    <p className="text-sm text-gray-500 dark:text-gray-400 font-medium mt-1">You need to create a course before starting a lecture.</p>
                  </div>
                  <Link href="/dashboard/courses" className="inline-block bg-[#2563EB] text-white font-bold px-6 py-3 rounded-xl shadow-md hover:bg-blue-700 transition-all">
                    Go to Course Management
                  </Link>
                </div>
              ) : (
                <div className="relative mb-4 mt-6">
                  <select value={selectedCourseId} onChange={(e) => setSelectedCourseId(e.target.value)} className="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white font-bold text-xl py-4 pl-4 pr-10 rounded-2xl outline-none focus:ring-2 focus:ring-[#2563EB] transition-all appearance-none cursor-pointer">
                    {courses.map(course => (
                      <option key={course.id} value={course.id}>
                        {course.course_code} {course.department ? `(${course.department})` : ''}
                      </option>
                    ))}
                  </select>
                  <div className="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-gray-500 dark:text-gray-400"><ChevronDown size={24} strokeWidth={2.5} /></div>
                </div>
              )}

              <div className="space-y-3 mt-4">
                <div className="flex items-center bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus-within:ring-2 focus-within:ring-[#2563EB] transition-all overflow-hidden">
                  <div className="pl-4 pr-3 flex items-center justify-center text-gray-400 dark:text-gray-500"><Timer size={20} /></div>
                  <select value={sessionDuration} onChange={(e) => setSessionDuration(Number(e.target.value))} className="w-full bg-transparent text-gray-900 dark:text-white font-bold py-4 pr-4 outline-none appearance-none cursor-pointer">
                    <option value={15}>Duration: 15 Minutes (Quiz)</option>
                    <option value={30}>Duration: 30 Minutes</option>
                    <option value={60}>Duration: 1 Hour (Standard)</option>
                    <option value={90}>Duration: 1.5 Hours</option>
                    <option value={120}>Duration: 2 Hours</option>
                  </select>
                </div>
                <div className="flex items-center bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus-within:ring-2 focus-within:ring-[#2563EB] transition-all overflow-hidden">
                  <div className="pl-4 pr-3 flex items-center justify-center text-gray-400 dark:text-gray-500"><Lock size={20} /></div>
                  <select value={checkinOpensAfter} onChange={(e) => setCheckinOpensAfter(Number(e.target.value))} className="w-full bg-transparent text-gray-900 dark:text-white font-bold py-4 pr-4 outline-none appearance-none cursor-pointer">
                    <option value={0}>Opens: Immediately</option>
                    <option value={5}>Opens: After 5 minutes</option>
                    <option value={10}>Opens: After 10 minutes</option>
                    <option value={15}>Opens: After 15 minutes</option>
                    <option value={30}>Opens: After 30 minutes</option>
                  </select>
                </div>
                {sessionDuration <= checkinOpensAfter && (
                  <p className="text-xs text-red-500 font-bold text-center mt-2 animate-pulse">
                    ⚠️ Warning: Check-in opens after {checkinOpensAfter} mins, but the class ends at {sessionDuration} mins. Students will have zero time to check in!
                  </p>
                )}
                <button onClick={startNewSession} disabled={isStarting || courses.length === 0} className="w-full flex items-center justify-center gap-2 bg-[#2563EB] text-white font-bold text-lg py-4 rounded-2xl shadow-md hover:bg-blue-700 active:scale-[0.98] transition-all disabled:opacity-70 mt-2">
                  {isStarting ? <RefreshCw className="animate-spin" size={20} /> : <MapPin size={20} />} {isStarting ? "Anchoring Geofence..." : "Establish Geofence"}
                </button>
                {setupError && <p className="text-sm text-red-500 font-bold mt-4">{setupError}</p>}
              </div>
            </div>
          ) : (
            <div className="animate-in fade-in slide-in-from-bottom-4 pb-10">
              {!viewingPastSession ? (
                <div className="space-y-4">
                  <div className="relative">
                    <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"><Search size={18} className="text-gray-400 dark:text-gray-500" /></div>
                    <input type="text" placeholder="Search by date or course..." value={historySearch} onChange={(e) => setHistorySearch(e.target.value)} className="w-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 p-3 pl-10 rounded-xl outline-none font-bold text-gray-900 dark:text-white placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:ring-2 focus:ring-[#2563EB] transition-all" />
                  </div>

                  {filteredHistory.map(session => (
                    <div key={session.session_id} className="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 p-5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:border-blue-300 dark:hover:border-blue-700 transition-colors">
                      <div>
                        <h3 className="font-black text-gray-900 dark:text-white text-lg">{session.course_code}</h3>
                        <p className="text-sm text-gray-500 dark:text-gray-400 font-medium">{new Date(session.created_at).toLocaleString()}</p>
                      </div>
                      <div className="flex flex-col sm:flex-row items-center gap-6 w-full sm:w-auto">
                        <div className="flex gap-6 w-full sm:w-auto justify-around">
                          <div className="text-center">
                            <p className="text-xl font-black text-green-600 dark:text-green-500">{session.verified_count}</p>
                            <p className="text-[10px] uppercase font-bold text-gray-400 dark:text-gray-500 tracking-wider">Verified</p>
                          </div>
                          <div className="text-center">
                            <p className="text-xl font-black text-red-500 dark:text-red-400">{session.flagged_count}</p>
                            <p className="text-[10px] uppercase font-bold text-gray-400 dark:text-gray-500 tracking-wider">Flagged</p>
                          </div>
                        </div>
                        <div className="flex gap-2 w-full sm:w-auto">
                          <button onClick={() => viewPastLedger(session)} className="flex-1 sm:flex-none justify-center bg-blue-50 dark:bg-blue-900/30 text-[#2563EB] dark:text-blue-400 px-4 py-2.5 rounded-xl font-bold text-sm hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-all flex items-center gap-2">
                            <FileText size={16} /> View
                          </button>
                          <button onClick={() => downloadPastSession(session.session_id, new Date(session.created_at).toLocaleDateString(), session.course_code)} disabled={downloadingId === session.session_id} className="flex-1 sm:flex-none justify-center bg-gray-900 dark:bg-gray-700 text-white px-4 py-2.5 rounded-xl font-bold text-sm hover:bg-gray-800 dark:hover:bg-gray-600 disabled:opacity-50 transition-all flex items-center gap-2">
                            {downloadingId === session.session_id ? <RefreshCw size={16} className="animate-spin" /> : <Download size={16} />} CSV
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
                  {filteredHistory.length === 0 && (
                    <p className="text-center text-gray-500 dark:text-gray-400 font-bold py-10 bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800">
                      {pastSessions.length === 0 ? "No past records found for this course." : "No records match your search."}
                    </p>
                  )}
                </div>
              ) : (
                <div className="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden transition-colors duration-300">
                  <div className="px-6 py-4 border-b border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50 flex justify-between items-center">
                    <div>
                      <h3 className="font-black text-gray-900 dark:text-white text-lg">Ledger: {viewingPastSession.course_code}</h3>
                      <p className="text-xs text-gray-500 dark:text-gray-400 font-bold">{new Date(viewingPastSession.created_at).toLocaleString()}</p>
                    </div>
                    <button onClick={() => setViewingPastSession(null)} className="text-sm font-bold text-gray-500 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 px-3 py-1.5 rounded-lg shadow-sm transition-colors">Close</button>
                  </div>
                  <div className="overflow-x-auto">
                    <table className="w-full text-left border-collapse whitespace-nowrap">
                      <thead>
                        <tr className="bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 text-xs uppercase tracking-wider text-gray-400 dark:text-gray-500">
                          <th className="px-6 py-4 font-bold">Matric Number</th>
                          <th className="px-6 py-4 font-bold">Time</th>
                          <th className="px-6 py-4 font-bold">Status</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-gray-50 dark:divide-gray-800">
                        {pastSessionLogs.map((log) => (
                          <tr key={log.id} className="hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-colors">
                            <td className="px-6 py-4 font-bold text-gray-900 dark:text-white">
                              {log.matricNumber}
                              {log.nickname && <span className="block text-[10px] text-gray-400 dark:text-gray-500">({log.nickname})</span>}
                            </td>
                            <td className="px-6 py-4 text-gray-500 dark:text-gray-400 flex items-center gap-2 text-sm font-medium"><Clock size={14} /> {log.time}</td>
                            <td className="px-6 py-4">
                              {log.status === 'verified' ? (
                                <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800"><CheckCircle size={12} /> Verified</span>
                              ) : (
                                <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800"><AlertTriangle size={12} /> Flagged</span>
                              )}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </div>
          )}
        </div>
        <ConfirmModal config={confirm.config} onClose={confirm.close} />
      </div>
    );
  }

  const verifiedLogs = data?.logs.filter(l => l.status === 'verified') || [];
  const flaggedLogs = data?.logs.filter(l => l.status !== 'verified') || [];

  return (
    <div className="min-h-screen bg-[#F9FAFB] dark:bg-gray-950 p-4 md:p-8 font-sans text-gray-900 dark:text-gray-100 transition-colors duration-300">
      <div className="max-w-5xl mx-auto space-y-6">
        
        <div className="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 p-4 md:p-6 transition-colors duration-300">
          <div className="flex flex-col md:flex-row md:items-start justify-between gap-4">
            <div>
              <div className="flex items-center gap-2 mb-1">
                <ShieldCheck size={20} className="text-[#2563EB] dark:text-blue-400" />
                <span className="text-sm font-bold text-[#2563EB] dark:text-blue-400 uppercase tracking-wider">CampusCheck • {profile?.full_name || 'Faculty'}</span>
              </div>
              <h1 className="text-2xl md:text-3xl font-extrabold tracking-tight">Live Attendance</h1>
              <div className="flex items-center gap-2 mt-2 flex-wrap">
                <span className="relative flex h-3 w-3">
                  <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                  <span className="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                </span>
                <span className="text-gray-500 dark:text-gray-400 font-bold text-lg">{data?.course || 'Loading...'}</span>

                {timeLeft && (
                  <span className={`flex items-center gap-1 text-xs font-bold px-2 py-1 rounded-md border ml-2 ${timeLeft === 'Expired' ? 'bg-red-50 text-red-600 border-red-200 dark:bg-red-900/30 dark:text-red-400 dark:border-red-800' : 'bg-blue-50 text-blue-600 border-blue-200 dark:bg-blue-900/30 dark:text-blue-400 dark:border-blue-800'}`}>
                    <Clock size={12} /> {timeLeft === 'Expired' ? 'Session Ended' : `Ends in ${timeLeft}`}
                  </span>
                )}
                
                {data?.startedBy === 'Class Rep' && (
                  <span className="flex items-center gap-1 text-xs font-bold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-2 py-1 rounded-md border border-amber-200 dark:border-amber-800 ml-2">
                    <ShieldAlert size={12} /> Started by Rep
                  </span>
                )}
                
                {!isOnline ? (
                  <span className="flex items-center gap-1 text-xs font-bold text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/30 px-2 py-1 rounded-md border border-red-200 dark:border-red-800 ml-2 animate-pulse">
                    <WifiOff size={12} /> Connection Lost
                  </span>
                ) : isSlowNetwork ? (
                  <span className="flex items-center gap-1 text-xs font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/30 px-2 py-1 rounded-md border border-amber-200 dark:border-amber-800 ml-2">
                    <Wifi size={12} /> Slow Network
                  </span>
                ) : (
                  <span className="flex items-center gap-1 text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2 py-1 rounded-md border border-blue-200 dark:border-blue-800 ml-2">
                    <Wifi size={12} /> Live Sync
                  </span>
                )}

                {data && (
                  <span className="flex items-center gap-1 text-xs font-bold text-gray-600 dark:text-gray-300 bg-gray-50 dark:bg-gray-800 px-2 py-1 rounded-md border border-gray-200 dark:border-gray-700 ml-2" title="Students are measured against this anchor">
                    <MapPin size={12} /> Anchor: {data.course ? 'set' : 'pending'}
                  </span>
                )}

                {data?.hiddenDisqualifiedCount !== undefined && data.hiddenDisqualifiedCount > 0 && (
                  <span className="flex items-center gap-1 text-xs font-bold text-red-700 dark:text-red-400 bg-red-50 dark:bg-red-900/30 px-2 py-1 rounded-md border border-red-200 dark:border-red-800 ml-2">
                    <ShieldAlert size={12} /> {data.hiddenDisqualifiedCount} attempts disqualified
                  </span>
                )}
              </div>
            </div>
            
            <div className="flex items-center justify-between bg-gray-50 dark:bg-gray-800/50 p-3 rounded-xl border border-gray-100 dark:border-gray-800 gap-4 w-full md:w-auto mt-2 md:mt-0">
              <div className="flex items-center gap-2">
                <ThemeToggle />
                <div>
                  <p className="text-2xl font-extrabold text-gray-900 dark:text-white">{data?.logs.length || 0}</p>
                  <p className="text-xs text-gray-500 dark:text-gray-400 font-bold uppercase tracking-wider">Total Check-ins</p>
                </div>
                
                {velocityData.length > 1 && isOnline && !isSlowNetwork && (
                  <div className="w-24 h-10 hidden sm:block" title="Check-in velocity">
                    <ResponsiveContainer width="100%" height="100%">
                      <AreaChart data={velocityData}>
                        <defs>
                          <linearGradient id="colorCount" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stopColor="#10b981" stopOpacity={0.3}/>
                            <stop offset="95%" stopColor="#10b981" stopOpacity={0}/>
                          </linearGradient>
                        </defs>
                        <YAxis hide domain={[0, 'dataMax + 1']} />
                        <Area type="monotone" dataKey="count" stroke="#10b981" strokeWidth={2} fillOpacity={1} fill="url(#colorCount)" />
                      </AreaChart>
                    </ResponsiveContainer>
                  </div>
                )}
              </div>
              <button onClick={exportLiveCSV} disabled={!data || data.logs.length === 0} className="bg-green-600 text-white px-4 py-2.5 rounded-lg font-bold text-sm hover:bg-green-700 disabled:opacity-50 flex items-center gap-2 shadow-sm transition-colors"><Download size={16} /> Export</button>
            </div>
          </div>
          
          <div className="grid grid-cols-2 md:grid-cols-3 gap-3 mt-4 pt-4 border-t border-gray-100 dark:border-gray-800">
            <button onClick={copySessionInfo} className="flex justify-center items-center gap-2 text-sm font-bold bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700 active:scale-[0.98] transition-all"><Copy size={16} /> Share Link</button>
            <button onClick={updateGeofence} disabled={isUpdatingGeofence} className="flex justify-center items-center gap-2 text-sm font-bold bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 px-4 py-2.5 rounded-xl border border-blue-200 dark:border-blue-800 shadow-sm hover:bg-blue-100 dark:hover:bg-blue-900/50 active:scale-[0.98] transition-all disabled:opacity-50">
              {isUpdatingGeofence ? <RefreshCw size={16} className="animate-spin" /> : <Navigation size={16} />} Update GPS
            </button>
            <button onClick={endSession} className="flex justify-center items-center gap-2 text-sm font-bold bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 px-4 py-2.5 rounded-xl border border-red-200 dark:border-red-800 shadow-sm hover:bg-red-100 dark:hover:bg-red-900/50 active:scale-[0.98] transition-all md:col-span-1 col-span-2"><XCircle size={16} /> End Lecture</button>
          </div>
        </div>

        <div className="bg-white dark:bg-gray-900 p-4 md:p-6 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 transition-colors duration-300">
          <h3 className="text-sm font-bold text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-2"><UserPlus size={16} className="text-[#2563EB] dark:text-blue-400"/> Students & Courses Management</h3>
          <div className="flex flex-col sm:flex-row gap-3">
            <input type="text" placeholder="Matric Number" value={manualMatric} onChange={(e) => setManualMatric(e.target.value.toUpperCase())} onKeyDown={(e) => e.key === 'Enter' && handleManualOverride(manualMatric)} className="w-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-3 rounded-xl outline-none font-bold text-gray-900 dark:text-white focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB] transition-all placeholder:text-gray-400 dark:placeholder:text-gray-500 placeholder:font-medium uppercase" />
            <div className="flex gap-2">
              <button onClick={() => handleManualOverride(manualMatric)} disabled={!manualMatric.trim() || isOverriding} className="whitespace-nowrap bg-gray-900 dark:bg-gray-700 text-white px-6 py-3 rounded-xl font-bold text-sm hover:bg-gray-800 dark:hover:bg-gray-600 disabled:opacity-50 transition-all flex justify-center items-center gap-2 shadow-md">
                {isOverriding ? <RefreshCw size={16} className="animate-spin" /> : <ShieldCheck size={16} />} {isOverriding ? "Forcing..." : "Force Check-In"}
              </button>
              <button onClick={() => handleDeviceReset(manualMatric)} disabled={!manualMatric.trim() || isResetting} className="whitespace-nowrap bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 px-4 py-3 rounded-xl font-bold text-sm border border-red-200 dark:border-red-800 hover:bg-red-100 dark:hover:bg-red-900/50 disabled:opacity-50 transition-all flex justify-center items-center gap-2">
                {isResetting ? <RefreshCw size={16} className="animate-spin" /> : <Trash2 size={16} />} Wipe
              </button>
            </div>
          </div>
        </div>

        <div className="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden transition-colors duration-300">
          <div className="flex border-b border-gray-100 dark:border-gray-800">
            <button 
              onClick={() => setLedgerTab('verified')} 
              className={`flex-1 py-4 text-sm font-bold flex items-center justify-center gap-2 transition-colors ${ledgerTab === 'verified' ? 'bg-green-50/50 dark:bg-green-900/20 text-green-700 dark:text-green-400 border-b-2 border-green-500' : 'text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800/50'}`}
            >
              <CheckCircle size={16} /> Verified ({verifiedLogs.length})
            </button>
            <button 
              onClick={() => setLedgerTab('flagged')} 
              className={`flex-1 py-4 text-sm font-bold flex items-center justify-center gap-2 transition-colors ${ledgerTab === 'flagged' ? 'bg-red-50/50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border-b-2 border-red-500' : 'text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800/50'}`}
            >
              <AlertTriangle size={16} /> Review Required ({flaggedLogs.length})
            </button>
          </div>

          <div className="overflow-x-auto">
            {ledgerTab === 'verified' ? (
              <table className="w-full text-left border-collapse whitespace-nowrap">
                <thead>
                  <tr className="bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 text-xs uppercase tracking-wider text-gray-400 dark:text-gray-500">
                    <th className="px-4 md:px-6 py-4 font-bold">Matric Number</th>
                    <th className="px-4 md:px-6 py-4 font-bold">Time</th>
                    <th className="px-4 md:px-6 py-4 font-bold">Status</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-gray-50 dark:divide-gray-800">
                  {verifiedLogs.length === 0 ? (
                    <tr><td colSpan={3} className="px-6 py-12 text-center text-gray-400 dark:text-gray-500 font-bold">No verified check-ins yet.</td></tr>
                  ) : (
                    verifiedLogs.map((log) => (
                      <tr key={log.id} className="hover:bg-gray-50/50 dark:hover:bg-gray-800/30 transition-colors">
                        <td className="px-4 md:px-6 py-3 md:py-4 font-bold text-gray-900 dark:text-white">
                          {log.matricNumber}
                          {log.nickname && <span className="block text-[10px] text-gray-400 dark:text-gray-500 font-semibold">({log.nickname})</span>}
                        </td>
                        <td className="px-4 md:px-6 py-3 md:py-4 text-gray-500 dark:text-gray-400 flex items-center gap-2 text-sm font-medium"><Clock size={14} /> {log.time}</td>
                        <td className="px-4 md:px-6 py-3 md:py-4">
                          {log.isBiometric ? (
                            <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-400 border border-green-200 dark:border-green-800"><CheckCircle size={12} strokeWidth={2.5} /> Biometric</span>
                          ) : (
                            <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-800"><MapPin size={12} strokeWidth={2.5} /> GPS Only</span>
                          )}
                        </td>
                      </tr>
                    ))
                  )}
                </tbody>
              </table>
            ) : (
              <div className="divide-y divide-gray-100 dark:divide-gray-800">
                {flaggedLogs.length === 0 ? (
                  <div className="px-6 py-12 text-center text-gray-400 dark:text-gray-500 font-bold">No students require review.</div>
                ) : (
                  flaggedLogs.map((log) => (
                    <div key={log.id} className="p-4 md:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-red-50/30 dark:hover:bg-red-900/10 transition-colors">
                      <div>
                        <p className="font-bold text-gray-900 dark:text-white text-lg">
                          {log.matricNumber}
                          {log.nickname && <span className="text-sm text-gray-500 dark:text-gray-400 font-medium ml-2">({log.nickname})</span>}
                        </p>
                        <div className="flex items-center gap-3 mt-1">
                          <span className="text-[10px] uppercase font-bold text-red-700 dark:text-red-400 bg-red-100 dark:bg-red-900/30 px-2 py-0.5 rounded-md flex items-center gap-1">
                            {log.status === 'pending_override' ? <Hand size={10} /> : <AlertTriangle size={10} />}
                            {log.status === 'pending_override' ? 'Raised Hand' : 'Flagged'}
                          </span>
                          <span className="text-xs text-gray-500 dark:text-gray-400 font-medium flex items-center gap-1">
                            <Clock size={12} /> {log.time}
                          </span>
                        </div>
                        <p className="text-xs text-gray-600 dark:text-gray-400 font-medium mt-2">
                          <strong>Reason:</strong> {log.reason || 'Biometric skipped or location anomaly'}
                        </p>
                      </div>
                      <button
                        onClick={() => handleManualOverride(log.matricNumber)}
                        className="whitespace-nowrap bg-white dark:bg-gray-800 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 px-5 py-2.5 rounded-xl font-bold text-sm shadow-sm hover:bg-red-50 dark:hover:bg-red-900/20 active:scale-[0.98] transition-all flex items-center justify-center gap-2"
                      >
                        <ShieldCheck size={16} /> Approve
                      </button>
                    </div>
                  ))
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      <ConfirmModal config={confirm.config} onClose={confirm.close} />
    </div>
  );
}
