<file path="app/api/alerts/low-attendance/route.ts">
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { verifyLecturer } from '@/utils/api-auth';
import webpush from 'web-push';

const publicVapidKey = process.env.NEXT_PUBLIC_VAPID_PUBLIC_KEY || '';
const privateVapidKey = process.env.VAPID_PRIVATE_KEY || '';
const subject = process.env.VAPID_SUBJECT || 'mailto:admin@campuscheck.com';

if (publicVapidKey && privateVapidKey) {
  webpush.setVapidDetails(subject, publicVapidKey, privateVapidKey);
}

export async function POST(request: Request) {
  try {
    const auth = await verifyLecturer(request);
    if (auth.error) return auth.error;

    const { courseId } = await request.json();
    if (!courseId) return NextResponse.json({ error: "Missing course ID" }, { status: 400 });

    const { data: course } = await supabase
      .from('courses')
      .select('id, course_code, total_planned_classes')
      .eq('id', courseId)
      .eq('lecturer_id', auth.user.id)
      .maybeSingle();

    if (!course) return NextResponse.json({ error: "Course not found or unauthorized" }, { status: 403 });

    const { data: sessions } = await supabase
      .from('lecture_sessions')
      .select('session_id')
      .eq('course_id', course.id);

    if (!sessions || sessions.length === 0) {
      return NextResponse.json({ message: "No sessions held yet." }, { status: 200 });
    }

    const sessionIds = sessions.map(s => s.session_id);
    const totalHeld = sessionIds.length;

    const { data: enrollments } = await supabase
      .from('enrollments')
      .select('matric_number')
      .eq('course_id', course.id);

    if (!enrollments || enrollments.length === 0) {
      return NextResponse.json({ message: "No students enrolled." }, { status: 200 });
    }

    const allMatrics = enrollments.map(e => e.matric_number);

    const { data: logs } = await supabase
      .from('attendance_logs')
      .select('matric_number')
      .in('session_id', sessionIds)
      .eq('status', 'verified');

    const attendanceCounts: Record<string, number> = {};
    logs?.forEach(log => {
      attendanceCounts[log.matric_number] = (attendanceCounts[log.matric_number] || 0) + 1;
    });

    const atRiskMatrics: string[] = [];
    allMatrics.forEach(matric => {
      const attended = attendanceCounts[matric] || 0;
      const percentage = (attended / totalHeld) * 100;
      if (percentage < 70) {
        atRiskMatrics.push(matric);
      }
    });

    if (atRiskMatrics.length === 0) {
      return NextResponse.json({ message: "No students are at risk. No alerts sent." }, { status: 200 });
    }

    const { data: subscriptions } = await supabase
      .from('push_subscriptions')
      .select('subscription, matric_number')
      .in('matric_number', atRiskMatrics);

    if (!subscriptions || subscriptions.length === 0) {
      return NextResponse.json({ message: "At-risk students found, but none have push notifications enabled." }, { status: 200 });
    }

    let successCount = 0;
    const payload = JSON.stringify({
      title: `⚠️ Attendance Warning: ${course.course_code}`,
      body: `Your attendance is currently below 70%. You need to attend the upcoming classes to avoid disqualification from exams.`,
      url: `/student-hub`
    });

    const pushPromises = subscriptions.map(sub => 
      webpush.sendNotification(sub.subscription, payload).then(() => {
        successCount++;
      }).catch(err => {
        if (err.statusCode === 410) {
          return supabase.from('push_subscriptions').delete().eq('matric_number', sub.matric_number);
        }
      })
    );

    await Promise.all(pushPromises);

    return NextResponse.json({ success: true, atRiskCount: atRiskMatrics.length, alertsSent: successCount });
  } catch (error) {
    console.error("Low Attendance Alert Error:", error);
    return NextResponse.json({ error: 'Failed to send alerts' }, { status: 500 });
  }
}
</file>

<file path="app/api/dashboard-data/route.ts">
export const dynamic = 'force-dynamic';
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { verifyLecturer } from '@/utils/api-auth';
import { verifyStudentToken } from '@/utils/student-auth';

interface AttendanceLogRow {
  id: string;
  matric_number: string;
  status: string;
  check_in_time: string;
  device_info: string | null;
}

export async function GET(request: Request) {
  try {
    const { searchParams } = new URL(request.url);
    const sessionId = searchParams.get('sessionId');
    const clientTimeZone = searchParams.get('timeZone') || 'Africa/Lagos';

    if (!sessionId) return NextResponse.json({ error: 'No sessionId' }, { status: 400 });

    let isStudent = false;
    const lecturerAuth = await verifyLecturer(request);
    
    if (lecturerAuth.error) {
      const studentAuth = verifyStudentToken(request);
      if (!studentAuth.error) {
        isStudent = true;
      } else {
        return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
      }
    }

    const { data: session } = await supabase
      .from('lecture_sessions')
      .select('is_active, course_code, created_at, course_id')
      .eq('session_id', sessionId)
      .maybeSingle();

    if (!session) return NextResponse.json({ error: 'Session not found' }, { status: 404 });

    if (isStudent) {
      return NextResponse.json({
        course: session.course_code,
        isActive: session.is_active,
        createdAt: session.created_at,
        logs: [] 
      });
    }

    // Verify ownership (Fallback for legacy sessions missing course_id)
    let courseQuery = supabase.from('courses').select('id').eq('lecturer_id', lecturerAuth.user!.id);
    if (session.course_id) {
      courseQuery = courseQuery.eq('id', session.course_id);
    } else {
      courseQuery = courseQuery.eq('course_code', session.course_code).limit(1);
    }
    
    const { data: course } = await courseQuery.maybeSingle();
    if (!course) return NextResponse.json({ error: 'Unauthorized' }, { status: 403 });

    const { data: logs } = await supabase
      .from('attendance_logs')
      .select('*')
      .eq('session_id', sessionId)
      .order('check_in_time', { ascending: false });

    const visibleLogs = (logs as AttendanceLogRow[] | null || []).filter(l => l.status !== 'disqualified');
    const disqualifiedCount = (logs as AttendanceLogRow[] | null || []).filter(l => l.status === 'disqualified').length;

    const matrics = visibleLogs.map(l => l.matric_number);
    const { data: profiles } = await supabase
      .from('student_profiles')
      .select('matric_number, nickname')
      .in('matric_number', matrics);

    const nicknameMap = new Map();
    (profiles || []).forEach(p => nicknameMap.set(p.matric_number, p.nickname));

    return NextResponse.json({
      course: session.course_code,
      isActive: session.is_active === true,
      createdAt: session.created_at || null,
      hiddenDisqualifiedCount: disqualifiedCount,
      logs: visibleLogs.map((l) => {
        let reason = null;
        let isBiometric = false;
        
        if (l.device_info) {
          try {
            const info = JSON.parse(l.device_info);
            if (info.method === "Digital Hand Raise") reason = "Raised hand (GPS blocked)";
            else if (info.verificationMethod === 'skipped') {
              reason = "Biometric skipped (No hardware lock)";
            } else if (info.verificationMethod === 'biometric') {
              isBiometric = true;
            } else if (info.reason) {
              reason = info.reason;
            }
          } catch {}
        }
        
        const localTimeString = new Date(l.check_in_time).toLocaleTimeString('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
          timeZone: clientTimeZone
        });

        return {
          id: l.id,
          matricNumber: l.matric_number,
          nickname: nicknameMap.get(l.matric_number) || null,
          status: l.status,
          time: localTimeString,
          reason,
          isBiometric
        };
      })
    });
  } catch {
    return NextResponse.json({ error: "Failed" }, { status: 500 });
  }
}
