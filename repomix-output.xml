            const [editingCourse, setEditingCourse] = useState(null);
            const [modalStudents, setModalStudents] = useState([]);

            const handleEndSession = () => { setIsSessionActive(false); showToast("Session ended."); };
            const startSession = () => { setIsSessionActive(true); showToast("Session started!"); };
            const approveLog = (id) => { setLogs(prev => prev.map(l => l.id === id ? { ...l, status: 'verified', method: 'Manual Override' } : l)); showToast("Verified."); };
            
            const handleForceCheckIn = () => {
                if (!manualMatric.trim()) return;
                setLogs(prev => [{ id: 'l_'+Date.now(), matric: manualMatric.toUpperCase(), status: 'verified', time: 'Now', method: 'Manual' }, ...prev]);
                setManualMatric('');
                showToast("Force Checked-In.");
            };

            const handleCreateCourse = () => {
                if (!newCourseCode.trim()) return;
                setCourses([...courses, { id: 'c_'+Date.now(), code: newCourseCode.toUpperCase(), dept: newDept, level: newLevel, planned: Number(plannedClasses), held: 0, maxScore: Number(maxScore) }]);
                showToast(`Created ${newCourseCode}.`);
                setNewCourseCode('');
            };

            const handleAudit = () => {
                if (!auditMatric.trim()) return;
                setAuditRecords([{ date: 'Oct 12, 2026', status: 'verified' }, { date: 'Oct 05, 2026', status: 'absent' }]);
            };

            const openManageModal = (course) => {
                setEditingCourse(course);
                setModalStudents(['CSC/2021/042', 'CSC/2021/015']);
