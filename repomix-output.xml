                    </div>

                    {isSessionActive && !studentHasCheckedIn && (
                        <div onClick={() => setActiveTab('checkin')} className="mx-4 mb-6 bg-green-600 text-white p-4 rounded-2xl shadow-lg flex items-center justify-between cursor-pointer pulse-border">
                            <div className="flex items-center gap-3">
                                <div className="bg-white/20 p-2 rounded-full"><i data-lucide="zap" className="w-5 h-5"></i></div>
                                <div>
                                    <p className="text-xs font-bold uppercase text-green-100">Live Class Now</p>
