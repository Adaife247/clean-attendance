                                                    <span>{Math.max(0, Math.floor(course.planned * 0.3) - (course.planned - e.attended))} Safe Skips</span>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            )}

                            {activeTab === 'checkin' && (
                                <div className="fade-in">
                                    {checkInState === 'idle' && (
