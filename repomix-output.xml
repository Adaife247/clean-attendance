<file path="components/lecturer/AttendanceCalendar.tsx">
'use client';
import { useState, useMemo } from 'react';
import { ChevronLeft, ChevronRight, Calendar as CalendarIcon } from 'lucide-react';

interface Session {
  session_id: string;
  created_at: string;
  verified_count: number;
  flagged_count: number;
}

interface AttendanceCalendarProps {
  sessions: Session[];
}

export default function AttendanceCalendar({ sessions }: AttendanceCalendarProps) {
  const [currentDate, setCurrentDate] = useState(new Date());
  const [selectedDay, setSelectedDay] = useState<string | null>(null);

  const year = currentDate.getFullYear();
  const month = currentDate.getMonth();

  const firstDayOfMonth = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();

  const prevMonth = () => {
    setCurrentDate(new Date(year, month - 1, 1));
    setSelectedDay(null);
  };
  
  const nextMonth = () => {
    setCurrentDate(new Date(year, month + 1, 1));
    setSelectedDay(null);
  };

  const sessionsByDate = useMemo(() => {
    const map = new Map<string, Session[]>();
    sessions.forEach(session => {
      // Force local timezone string to prevent UTC shifting
      const localDate = new Date(session.created_at);
      const dateStr = `${localDate.getFullYear()}-${String(localDate.getMonth() + 1).padStart(2, '0')}-${String(localDate.getDate()).padStart(2, '0')}`;
      if (!map.has(dateStr)) map.set(dateStr, []);
      map.get(dateStr)!.push(session);
    });
    return map;
  }, [sessions]);

  const monthName = currentDate.toLocaleString('default', { month: 'long' });
  const daysOfWeek = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  const handleDayClick = (day: number) => {
    const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    if (sessionsByDate.has(dateStr)) {
      setSelectedDay(dateStr === selectedDay ? null : dateStr);
    }
  };

  const selectedSessions = selectedDay ? sessionsByDate.get(selectedDay) || [] : [];

  return (
    <div className="bg-white dark:bg-gray-900 rounded-3xl shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden transition-colors">
      <div className="p-6 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center bg-gray-50/50 dark:bg-gray-800/50">
        <div className="flex items-center gap-3">
          <div className="bg-blue-100 dark:bg-blue-900/40 p-2 rounded-xl text-[#2563EB] dark:text-blue-400">
            <CalendarIcon size={24} />
          </div>
          <div>
            <h2 className="text-xl font-extrabold text-gray-900 dark:text-white">Attendance Calendar</h2>
            <p className="text-sm text-gray-500 dark:text-gray-400 font-medium">Visual history of class sessions</p>
          </div>
        </div>
        <div className="flex gap-2">
          <button onClick={prevMonth} className="p-2 rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <ChevronLeft size={20} className="text-gray-600 dark:text-gray-300" />
          </button>
          <span className="flex items-center px-4 font-bold text-gray-900 dark:text-white min-w-37.5 justify-center">
            {monthName} {year}
          </span>
          <button onClick={nextMonth} className="p-2 rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <ChevronRight size={20} className="text-gray-600 dark:text-gray-300" />
          </button>
        </div>
      </div>

      <div className="p-6">
        <div className="grid grid-cols-7 gap-2 mb-2 text-center">
          {daysOfWeek.map(day => (
            <div key={day} className="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider py-2">
              {day}
            </div>
          ))}
        </div>

        <div className="grid grid-cols-7 gap-2">
          {Array.from({ length: firstDayOfMonth }).map((_, i) => (
            <div key={`empty-${i}`} className="h-16 rounded-xl bg-gray-50/50 dark:bg-gray-800/20 border border-transparent" />
          ))}
          
          {Array.from({ length: daysInMonth }).map((_, i) => {
            const day = i + 1;
            const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
            const daySessions = sessionsByDate.get(dateStr);
            const hasSessions = !!daySessions;
            const isSelected = selectedDay === dateStr;

            return (
              <button
                key={day}
                onClick={() => handleDayClick(day)}
                disabled={!hasSessions}
                className={`h-16 rounded-xl border flex flex-col items-center justify-center relative transition-all ${
                  isSelected 
                    ? 'border-[#2563EB] bg-blue-50 dark:bg-blue-900/30 ring-2 ring-[#2563EB] ring-offset-2 dark:ring-offset-gray-900' 
                    : hasSessions 
                      ? 'border-blue-100 dark:border-blue-900/50 bg-blue-50/50 dark:bg-blue-900/10 hover:border-blue-300 dark:hover:border-blue-700 cursor-pointer shadow-sm' 
                      : 'border-transparent text-gray-400 dark:text-gray-600 opacity-50 cursor-default'
                }`}
              >
                <span className={`text-sm font-bold ${hasSessions ? 'text-[#2563EB] dark:text-blue-400' : ''}`}>
                  {day}
                </span>
                {hasSessions && (
                  <span className="absolute bottom-2 w-1.5 h-1.5 rounded-full bg-[#2563EB] dark:bg-blue-400" />
                )}
              </button>
            );
          })}
        </div>
      </div>

      {selectedDay && selectedSessions.length > 0 && (
        <div className="p-6 bg-gray-50 dark:bg-gray-800/50 border-t border-gray-100 dark:border-gray-800 animate-in slide-in-from-top-2">
          <h3 className="text-sm font-bold text-gray-900 dark:text-white mb-4">
            Sessions on {new Date(selectedDay).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' })}
          </h3>
          <div className="space-y-3">
            {selectedSessions.map((session, i) => (
              <div key={session.session_id} className="bg-white dark:bg-gray-900 p-4 rounded-xl border border-gray-200 dark:border-gray-700 flex justify-between items-center shadow-sm">
                <div>
                  <p className="font-bold text-gray-900 dark:text-white text-sm">
                    {new Date(session.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                  </p>
                  <p className="text-xs text-gray-500 dark:text-gray-400 font-medium mt-0.5">Session {i + 1}</p>
                </div>
                <div className="flex gap-4">
                  <div className="text-center">
                    <p className="text-lg font-black text-emerald-600 dark:text-emerald-400">{session.verified_count}</p>
                    <p className="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Present</p>
                  </div>
                  <div className="text-center">
                    <p className="text-lg font-black text-red-500 dark:text-red-400">{session.flagged_count}</p>
                    <p className="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Flagged</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="components/lecturer/FlagReview.tsx">
'use client';
import { useState, useEffect } from 'react';
import { ShieldAlert, ChevronDown, ChevronUp, AlertTriangle, ShieldCheck } from 'lucide-react';
import { FLAG_REASONS, FlagCode } from '@/utils/flag-reasons';
import { getLecturerHeaders } from '@/utils/api-client';

interface FlagItem {
  id: string;
  matric_number: string;
  reason_code: string;
  reason_detail: Record<string, unknown> | null;
  created_at: string;
}

export default function FlagReview() {
  const [loading, setLoading] = useState(true);
  const [checkinFlags, setCheckinFlags] = useState<FlagItem[]>([]);
  const [regFlags, setRegFlags] = useState<FlagItem[]>([]);
  const [expanded, setExpanded] = useState<string | null>(null);

  useEffect(() => {
    const fetchFlags = async () => {
      try {
        const headers = await getLecturerHeaders();
        const res = await fetch('/api/lecturer/flags', { headers });
        if (res.ok) {
          const data = await res.json();
          setCheckinFlags(data.checkinFlags || []);
          setRegFlags(data.regFlags || []);
        }
      } catch (err) {
        console.error(err);
      } finally {
        setLoading(false);
      }
    };
    fetchFlags();
  }, []);

  if (loading) return <div className="p-8 text-center text-gray-500 animate-pulse">Loading security flags...</div>;

  const totalFlags = checkinFlags.length + regFlags.length;

  if (totalFlags === 0) {
    return (
      <div className="bg-white dark:bg-gray-900 p-8 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800 text-center transition-colors">
        <div className="bg-emerald-50 dark:bg-emerald-900/30 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <ShieldCheck className="text-emerald-500" size={32} />
        </div>
        <h3 className="text-lg font-bold text-gray-900 dark:text-white">No Security Flags</h3>
        <p className="text-sm text-gray-500 dark:text-gray-400 mt-1">All recent check-ins and registrations passed verification.</p>
      </div>
    );
  }

  // Group by reason_code
  const groupedFlags = [...checkinFlags, ...regFlags].reduce<Record<string, FlagItem[]>>((acc, flag) => {
    const code = flag.reason_code as FlagCode;
    if (!acc[code]) acc[code] = [];
    acc[code].push(flag);
    return acc;
  }, {});

  return (
    <div className="bg-white dark:bg-gray-900 rounded-2xl shadow-sm border border-red-200 dark:border-red-900/50 overflow-hidden transition-colors">
      <div className="p-6 border-b border-red-100 dark:border-red-900/30 bg-red-50/30 dark:bg-red-900/10">
        <h2 className="text-xl font-extrabold text-red-900 dark:text-red-400 flex items-center gap-2">
          <ShieldAlert size={24} /> Security Flags ({totalFlags})
        </h2>
        <p className="text-sm text-red-700 dark:text-red-300 font-medium mt-1">Review proxy attempts and location spoofing anomalies.</p>
      </div>
      <div className="divide-y divide-gray-100 dark:divide-gray-800">
        {Object.entries(groupedFlags).map(([code, flags]) => {
          const reason = FLAG_REASONS[code as FlagCode] || {
            messageLecturer: 'Unknown security flag',
            severity: 'error',
          };
          
          return (
            <div key={code}>
              <button
                onClick={() => setExpanded(expanded === code ? null : code)}
                className="w-full flex items-center justify-between p-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors"
              >
                <div className="flex items-center gap-3">
                  <div className={`p-2 rounded-lg ${reason.severity === 'error' ? 'bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400' : 'bg-orange-100 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400'}`}>
                    <AlertTriangle size={18} />
                  </div>
                  <div className="text-left">
                    <p className="font-bold text-gray-900 dark:text-white">{code.replace(/_/g, ' ')}</p>
                    <p className="text-xs text-gray-500 dark:text-gray-400 font-medium">{reason.messageLecturer}</p>
                  </div>
                </div>
                <div className="flex items-center gap-4">
                  <span className="bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-xs font-bold px-2.5 py-1 rounded-full">
                    {flags.length}
                  </span>
                  {expanded === code ? <ChevronUp size={20} className="text-gray-400" /> : <ChevronDown size={20} className="text-gray-400" />}
                </div>
              </button>

              {expanded === code && (
                <div className="bg-gray-50 dark:bg-gray-800/30 p-4 space-y-2 border-t border-gray-100 dark:border-gray-800">
                  {flags.map((flag) => (
                    <div key={flag.id} className="bg-white dark:bg-gray-900 p-3 rounded-xl border border-gray-200 dark:border-gray-700 flex flex-col md:flex-row justify-between items-start md:items-center shadow-sm gap-2">
                      <div>
                        <p className="font-bold text-gray-900 dark:text-white text-sm">{flag.matric_number}</p>
                        <p className="text-[10px] text-gray-500 font-medium">{new Date(flag.created_at).toLocaleString()}</p>
                      </div>
                      {flag.reason_detail && (
                        <p className="text-xs text-gray-600 dark:text-gray-400 font-mono bg-gray-50 dark:bg-gray-800 p-1.5 rounded break-all w-full md:w-auto text-left md:text-right">
                          {JSON.stringify(flag.reason_detail).replace(/["{}]/g, '').replace(/,/g, ', ')}
                        </p>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
}
</file>

