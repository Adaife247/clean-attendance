                        <button onClick={() => setActiveTab('manage')} className={`flex-1 py-2 rounded-xl text-xs font-bold transition-all ${activeTab === 'manage' ? 'bg-[#2563EB] text-white shadow-md' : 'text-gray-500'}`}>Manage</button>
                    </div>

                    <div className="p-4 space-y-6">
                        
                        {/* RADAR TAB (Deeply Detailed) */}
