          >
            {isWiping ? <RefreshCw size={18} className="animate-spin" /> : <Trash2 size={18} />}
            Wipe Device
          </button>
        </div>
      </div>

      <FlagReview />

      <ConfirmModal config={confirm.config} onClose={confirm.close} />
    </div>
  );
}
