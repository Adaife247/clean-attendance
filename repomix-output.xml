            }

            const tabs = [
                { id: 'dashboard', label: 'Status', icon: 'zap' },
                { id: 'records', label: 'Records', icon: 'file-text' },
                { id: 'register', label: 'Enroll', icon: 'plus' },
                { id: 'feed', label: 'Feed', icon: 'megaphone' }
            ];
            if (isClassRep) tabs.push({ id: 'rep', label: 'Rep Desk', icon: 'book-open' });

            return (
                <div className="slide-up pb-12">
                    <div className="text-center mb-6 pt-4 px-4 relative">
                        <div className="bg-[#2563EB] w-14 h-14 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30 mb-4 relative overflow-hidden mx-auto">
                            <i data-lucide="shield-check" className="w-7 h-7 text-white z-10"></i>
                        </div>
                        <h1 className="text-2xl font-black text-gray-900 tracking-tight">Hey, D-Boy!</h1>
