<file path="app/api/onboard/save-email/route.ts">
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { checkRateLimit, getClientIp, rateLimitHeaders } from '@/utils/rate-limit';

export async function POST(request: Request) {
  try {
    const ip = getClientIp(request);
    // Rate limit: 5 email saves per minute per IP
    const rateCheck = await checkRateLimit(`save-email:${ip}`, 5, 60_000);

    if (!rateCheck.allowed) {
      return NextResponse.json(
        { error: "Too many requests. Please wait a minute." },
        { status: 429, headers: rateLimitHeaders(rateCheck) }
      );
    }

    const { matricNumber, recoveryEmail } = await request.json();

    if (!matricNumber || !recoveryEmail || !recoveryEmail.includes('@')) {
      return NextResponse.json({ error: "Invalid data provided." }, { status: 400 });
    }

    const cleanMatric = matricNumber.toUpperCase().trim();
    const cleanEmail = recoveryEmail.trim().toLowerCase();

    // 1. Verify they are actually enrolled
    const { data: enrollments } = await supabase
      .from('enrollments')
      .select('id')
      .eq('matric_number', cleanMatric)
      .limit(1);

    if (!enrollments || enrollments.length === 0) {
      return NextResponse.json({ error: "Matric number is not enrolled in any course." }, { status: 403 });
    }

    // 2. Check if they already have a credential (if so, they shouldn't be onboarding)
    const { data: existingDevice } = await supabase
      .from('user_devices')
      .select('credential_id')
      .eq('matric_number', cleanMatric)
      .maybeSingle();

    if (existingDevice) {
      return NextResponse.json({ error: "This matric already has a linked phone." }, { status: 409 });
    }

    // 3. Save the email
    const { error: profileError } = await supabase
      .from('student_profiles')
      .upsert({
        matric_number: cleanMatric,
        recovery_email: cleanEmail,
      }, { onConflict: 'matric_number' });

    if (profileError) throw profileError;

    return NextResponse.json({ success: true }, { headers: rateLimitHeaders(rateCheck) });

  } catch (error) {
    console.error("Save Email API Error:", error);
    return NextResponse.json({ error: "Internal server error" }, { status: 500 });
  }
}
</file>

<file path="app/api/rate-session/route.ts">
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { verifyStudentToken } from '@/utils/student-auth';

interface RateBody {
  sessionId: string;
  rating: number;
  tags: string[];
}

export async function POST(request: Request) {
  try {
    const auth = verifyStudentToken(request);
    if (auth.error) return auth.error;

    const body = (await request.json()) as RateBody;
    const { sessionId, rating, tags } = body;
    
    // Trust the matric from the token
    const cleanMatric = auth.matric!;

    if (!sessionId || typeof rating !== 'number' || rating < 1 || rating > 5) {
      return NextResponse.json({ error: 'Invalid rating payload' }, { status: 400 });
    }

    const { data: log } = await supabase
      .from('attendance_logs')
      .select('status')
      .eq('session_id', sessionId)
      .eq('matric_number', cleanMatric)
      .single();

    if (!log || log.status !== 'verified') {
      return NextResponse.json({ error: 'You must be verified to rate this session.' }, { status: 403 });
    }

    const cleanTags = Array.isArray(tags)
      ? tags.filter(t => typeof t === 'string').slice(0, 10)
      : [];

    const { error } = await supabase
      .from('session_ratings')
      .insert([{
        session_id: sessionId,
        rating,
        tags: cleanTags,
      }]);

    if (error) throw error;

    return NextResponse.json({ success: true });
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Failed to record rating';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
</file>

<file path="app/api/rep/upload-roster/route.ts">
// app/api/rep/upload-roster/route.ts
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { verifyStudentToken } from '@/utils/student-auth';

export async function POST(request: Request) {
  try {
    const auth = verifyStudentToken(request);
    if (auth.error) return auth.error;
    const repMatric = auth.matric!;

    const body = await request.json();
    const { courseId, matrics } = body;

    if (!courseId || !matrics || !Array.isArray(matrics)) {
      return NextResponse.json({ error: "Missing data" }, { status: 400 });
    }

    // 1. Verify the student is actually the Class Rep for this course
    const { data: rep } = await supabase
      .from('course_reps')
      .select('id')
      .eq('course_id', courseId)
      .eq('matric_number', repMatric)
      .maybeSingle();

    if (!rep) {
      return NextResponse.json({ error: "Unauthorized: You are not the rep for this course." }, { status: 403 });
    }

    // 2. Upload the roster
    const rows = matrics.map((matric: string) => ({
      course_id: courseId,
      matric_number: matric.toUpperCase().trim(),
    }));

    const { error } = await supabase
      .from('enrollments')
      .upsert(rows, { onConflict: 'course_id,matric_number', ignoreDuplicates: true });

    if (error) throw error;

    return NextResponse.json({ success: true });
  } catch (error) {
    console.error("Rep Upload Error:", error);
    return NextResponse.json({ error: "Failed to upload roster" }, { status: 500 });
  }
}
</file>

