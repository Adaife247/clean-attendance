                                                <span className="font-bold text-gray-800 text-xs">{matric}</span>
                                                <button className="text-red-400 p-1 hover:bg-red-50 rounded"><i data-lucide="trash-2" className="w-3 h-3"></i></button>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}

                </div>
            );
        }

        // ============================================================================
        // RENDER APP
        // ============================================================================
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
