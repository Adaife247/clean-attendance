import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { verifyLecturer } from '@/utils/api-auth';

// Helper to sanitize CSV cells and prevent CSV Injection
function sanitizeCSV(val: string | number) {
  const str = String(val);
  if (/^[=+\-@]/.test(str)) {
    return `'${str}`; // Prepend single quote to neutralize formulas
  }
  return str;
}

export async function GET(request: Request) {
  try {
    const auth = await verifyLecturer(request);
    if (auth.error) return auth.error;

    const { searchParams } = new URL(request.url);
    const courseCode = searchParams.get('courseCode');
    const startDate = searchParams.get('startDate');
    const endDate = searchParams.get('endDate');

    if (!courseCode) return NextResponse.json({ error: "Missing course code" }, { status: 400 });

    const { data: courseData } = await supabase
      .from('courses')
      .select('id, total_planned_classes, max_attendance_score, is_finalized')
      .eq('course_code', courseCode)
      .eq('lecturer_id', auth.user.id)
      .single();

    if (!courseData) {
       return NextResponse.json({ error: "Course not found or unauthorized" }, { status: 404 });
    }

    let query = supabase.from('lecture_sessions').select('session_id').eq('course_code', courseCode);
    if (startDate) query = query.gte('created_at', new Date(startDate).toISOString());
    if (endDate) {
      const end = new Date(endDate);
      end.setHours(23, 59, 59, 999);
      query = query.lte('created_at', end.toISOString());
    }

    const { data: sessions } = await query;
    if (!sessions || sessions.length === 0) {
      return NextResponse.json({ message: "No sessions recorded for this timeframe." }, { status: 404 });
    }

    const sessionIds = sessions.map(s => s.session_id);
    const totalClassesHeld = sessions.length;

    const { data: enrollments } = await supabase.from('enrollments').select('matric_number').eq('course_id', courseData.id);
    const roster = enrollments?.map(e => e.matric_number) || [];

    const { data: logs } = await supabase.from('attendance_logs').select('matric_number, status').in('session_id', sessionIds).eq('status', 'verified');

    const attendanceMap = new Map<string, number>();
    roster.forEach((matric: string) => attendanceMap.set(matric, 0));

    (logs || []).forEach(log => {
      if (!attendanceMap.has(log.matric_number)) attendanceMap.set(log.matric_number, 0);
      attendanceMap.set(log.matric_number, attendanceMap.get(log.matric_number)! + 1);
    });

    const report = Array.from(attendanceMap.entries()).map(([matric, attended]) => {
      const percentage = Math.round((attended / totalClassesHeld) * 100);
      return { 
        matricNumber: sanitizeCSV(matric), 
        totalClasses: totalClassesHeld, 
        attended, 
        percentage, 
        eligible: percentage >= 70 ? 'YES' : 'NO' 
      };
    });

    report.sort((a, b) => a.matricNumber.localeCompare(b.matricNumber));

    return NextResponse.json({
        course: courseCode,
        totalClasses: totalClassesHeld,
        plannedClasses: courseData.total_planned_classes || 15,
        maxScore: courseData.max_attendance_score || 10,
        isFinalized: courseData.is_finalized || false,
        report
    });

  } catch {
    return NextResponse.json({ error: "Failed to generate export" }, { status: 500 });
  }
}
</file>

<file path="app/api/rep-action/route.ts">
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';

export async function POST(request: Request) {
  try {
    const body = await request.json();
    const { action, sessionId, matricNumber, repMatric } = body;

    // 1. Verify the requester is actually a Class Rep
    const { data: repProfile } = await supabase
      .from('student_profiles')
      .select('is_class_rep')
      .eq('matric_number', repMatric)
      .single();

    if (!repProfile?.is_class_rep) {
      return NextResponse.json({ error: "Unauthorized. Only Class Reps can do this." }, { status: 403 });
    }

    // 2. Ensure the Rep is enrolled in the course
    const { data: session } = await supabase.from('lecture_sessions').select('course_code').eq('session_id', sessionId).single();
    if (!session) return NextResponse.json({ error: "Session not found" }, { status: 404 });

    const { data: course } = await supabase.from('courses').select('id').eq('course_code', session.course_code).single();

    const { data: repEnrollment } = await supabase.from('enrollments')
      .select('id')
      .eq('course_id', course?.id)
      .eq('matric_number', repMatric)
      .single();

    if (!repEnrollment) {
      return NextResponse.json({ error: "Unauthorized. Rep must be enrolled in this course." }, { status: 403 });
    }

    if (action === 'log_dead_battery') {
      if (!sessionId || !matricNumber) {
        return NextResponse.json({ error: "Missing session or matric" }, { status: 400 });
      }

      const cleanMatric = matricNumber.toUpperCase().trim();

      // 3. NEW: Ensure the TARGET student is also enrolled in this course
      const { data: targetEnrollment } = await supabase.from('enrollments')
        .select('id')
        .eq('course_id', course?.id)
        .eq('matric_number', cleanMatric)
        .single();

      if (!targetEnrollment) {
        return NextResponse.json({ error: "This student is not enrolled in this course." }, { status: 403 });
      }

      // 4. Check the 3-student cap
      const { count } = await supabase
        .from('attendance_logs')
        .select('*', { count: 'exact', head: true })
        .eq('session_id', sessionId)
        .eq('device_hash', 'rep-battery-log');

      if (count !== null && count >= 3) {
        return NextResponse.json({ error: "Limit reached. Only 3 students can claim battery dead per class." }, { status: 403 });
      }

      // 5. Check for existing log
      const { data: existingLog } = await supabase
        .from('attendance_logs')
        .select('id, status')
        .eq('session_id', sessionId)
        .eq('matric_number', cleanMatric)
        .single();

      if (existingLog) {
        if (existingLog.status === 'verified') {
           return NextResponse.json({ error: "Student is already verified." }, { status: 409 });
        }
        await supabase.from('attendance_logs').update({
          status: 'pending_override',
          device_info: JSON.stringify({ method: "Class Rep - Battery Dead" }),
          device_hash: 'rep-battery-log'
        }).eq('id', existingLog.id);
      } else {
        await supabase.from('attendance_logs').insert([{
          session_id: sessionId,
          matric_number: cleanMatric,
          status: 'pending_override',
          device_info: JSON.stringify({ method: "Class Rep - Battery Dead" }),
          device_hash: 'rep-battery-log'
        }]);
      }

      return NextResponse.json({ success: true });
    }

    return NextResponse.json({ error: "Invalid action" }, { status: 400 });
  } catch {
    return NextResponse.json({ error: "Internal server error" }, { status: 500 });
  }
}
</file>

