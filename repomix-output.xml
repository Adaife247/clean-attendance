                        </div>
                    </header>

                    {toast && (
                        <div className={`fixed top-16 left-1/2 -translate-x-1/2 px-4 py-2.5 rounded-xl shadow-xl z-50 font-bold text-white slide-up text-sm w-[90%] max-w-sm text-center ${toast.type === 'error' ? 'bg-red-600' : 'bg-gray-900'}`}>
                            {toast.msg}
                        </div>
                    )}

                    <div className="flex-1 overflow-y-auto">
                        {activeView === 'student' && (
                            <StudentPortal 
                                isSessionActive={isSessionActive} logs={logs} setLogs={setLogs}
                                enrollments={enrollments} setEnrollments={setEnrollments}
                                studentHasCheckedIn={studentHasCheckedIn} setStudentHasCheckedIn={setStudentHasCheckedIn}
                                showToast={showToast}
                            />
                        )}
                        
                        {activeView === 'lecturer' && (
                            <LecturerDashboard 
                                isSessionActive={isSessionActive} setIsSessionActive={setIsSessionActive}
                                logs={logs} setLogs={setLogs} analyticsData={INITIAL_DATA.analyticsData}
                                courses={courses} setCourses={setCourses} enrollments={enrollments} setEnrollments={setEnrollments}
                                showToast={showToast}
                            />
                        )}
                    </div>
                </div>
            );
        }

        // ============================================================================
        // STUDENT PORTAL
        // ============================================================================
        function StudentPortal({ isSessionActive, logs, setLogs, enrollments, setEnrollments, studentHasCheckedIn, setStudentHasCheckedIn, showToast }) {
            const [isUnlocked, setIsUnlocked] = useState(false);
            const [activeTab, setActiveTab] = useState('dashboard'); 
            const [checkInState, setCheckInState] = useState('idle');
            const [isClassRep] = useState(true); 

            const handleUnlock = () => { setIsUnlocked(true); showToast("Biometric passkey verified"); };
            const handleCheckIn = () => setCheckInState('ready');
            
            const executeFinalCheckIn = () => {
                setCheckInState('locating');
                setTimeout(() => {
                    setCheckInState('verifying');
                    setTimeout(() => {
                        setCheckInState('success');
                        setStudentHasCheckedIn(true);
                        setLogs(prev => [{ id: 'l_'+Date.now(), matric: 'CSC/2021/001', status: 'verified', time: 'Just now', method: 'Biometric' }, ...prev]);
                        setEnrollments(prev => prev.map(e => e.courseId === 'c1' ? { ...e, attended: e.attended + 1, streak: e.streak + 1 } : e));
                    }, 2000);
                }, 2000);
            };

            const handleEnroll = (courseId, courseCode) => {
                if (enrollments.find(e => e.courseId === courseId)) return;
                setEnrollments(prev => [...prev, { courseId, matric: 'CSC/2021/001', attended: 0, streak: 0 }]);
                showToast(`Enrolled in ${courseCode}!`);
            };

            const getShieldColor = (pct) => {
                if (pct >= 70) return { bar: 'bg-emerald-500', text: 'text-emerald-700', bg: 'bg-emerald-50/50', border: 'border-emerald-200' };
                if (pct >= 50) return { bar: 'bg-amber-400', text: 'text-amber-700', bg: 'bg-amber-50/50', border: 'border-amber-200' };
                return { bar: 'bg-red-500', text: 'text-red-700', bg: 'bg-red-50/50', border: 'border-red-200' };
            };

            if (!isUnlocked) {
                return (
                    <div className="p-4 mt-8 slide-up">
                        <div className="text-center mb-6">
                            <div className="bg-[#2563EB] w-14 h-14 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30 mx-auto mb-4 relative overflow-hidden">
                                <i data-lucide="shield-check" className="w-7 h-7 text-white z-10"></i>
                                <div className="absolute top-0 left-0 w-full h-1/2 bg-white/10 rounded-t-2xl"></div>
                            </div>
                            <h1 className="text-2xl font-black text-gray-900 tracking-tight">Survival Companion</h1>
                        </div>
                        <div className="bg-white rounded-3xl shadow-xl border border-gray-200 p-6">
                            <input type="text" defaultValue="CSC/2021/001" disabled className="w-full bg-gray-50 border border-gray-200 text-gray-900 font-bold text-lg py-4 px-4 rounded-2xl outline-none uppercase mb-4" />
                            <button onClick={handleUnlock} className="w-full flex items-center justify-center gap-2 bg-[#2563EB] text-white font-bold text-lg py-4 rounded-2xl shadow-lg active:scale-95 transition-all">
                                <i data-lucide="lock" className="w-5 h-5"></i> Unlock Portal
