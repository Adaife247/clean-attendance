        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body>

    <main id="root" class="flex-1 overflow-hidden relative"></main>

    <script type="text/babel">
        const { useState, useEffect } = React;

        // ============================================================================
        // MOCK DATA
        // ============================================================================
        const INITIAL_DATA = {
            courses: [
                { id: 'c1', code: 'CSC 301', dept: 'CSC', level: '300', planned: 15, held: 12, maxScore: 10 },
                { id: 'c2', code: 'CSC 305', dept: 'CSC', level: '300', planned: 15, held: 10, maxScore: 10 }
            ],
            enrollments: [
                { courseId: 'c1', matric: 'CSC/2021/001', attended: 10, streak: 3 },
                { courseId: 'c2', matric: 'CSC/2021/001', attended: 6, streak: 0 },
                { courseId: 'c1', matric: 'CSC/2021/042', attended: 12, streak: 5 },
                { courseId: 'c1', matric: 'CSC/2021/015', attended: 8, streak: 0 }
            ],
            logs: [
                { id: 'l1', matric: 'CSC/2021/042', status: 'verified', time: '10:01', method: 'Biometric' },
                { id: 'l2', matric: 'CSC/2021/015', status: 'pending_override', time: '10:03', method: 'Raised Hand (GPS weak)' }
            ],
            feed: [
                { id: 'f1', title: 'Mid-Term Exam Venue Change', content: 'Please note that the CSC 301 mid-term will now hold in the Main Auditorium.', date: '2 hours ago', course: 'CSC 301' },
                { id: 'f2', title: 'Assignment Deadline Extended', content: 'The deadline for the DBMS assignment has been moved to Friday.', date: '1 day ago', course: 'CSC 305' }
            ],
            analyticsData: [
                { matric: 'CSC/2021/001', attended: 12 },
                { matric: 'CSC/2021/002', attended: 10 },
                { matric: 'CSC/2021/003', attended: 8 },
                { matric: 'CSC/2021/004', attended: 14 },
                { matric: 'CSC/2021/005', attended: 5 }
            ]
        };

        // ============================================================================
        // MAIN APP ROUTER
        // ============================================================================
        function App() {
            const [activeView, setActiveView] = useState('student'); 
            const [toast, setToast] = useState(null);

            const [isSessionActive, setIsSessionActive] = useState(true); // Default to true so we see the radar
            const [logs, setLogs] = useState(INITIAL_DATA.logs);
            const [studentHasCheckedIn, setStudentHasCheckedIn] = useState(false);
            const [enrollments, setEnrollments] = useState(INITIAL_DATA.enrollments);
            const [courses, setCourses] = useState(INITIAL_DATA.courses);

            const showToast = (msg, type = 'success') => {
                setToast({ msg, type });
                setTimeout(() => setToast(null), 3000);
            };

            useEffect(() => { lucide.createIcons(); }, [activeView, toast, isSessionActive, logs, studentHasCheckedIn, enrollments, courses]);

            return (
                <div className="w-full h-full flex flex-col bg-[#F9FAFB] max-w-md mx-auto border-x border-gray-200 shadow-2xl">
