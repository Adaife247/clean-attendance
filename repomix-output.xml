                                    <button onClick={() => showToast("Downloading CSV...")} className="w-full bg-green-600 text-white font-bold py-3 rounded-xl text-sm shadow-sm mb-4">Download CSV</button>
                                    
                                    <button onClick={() => setShowAdvanced(!showAdvanced)} className="w-full flex justify-between items-center text-xs font-bold text-gray-500 bg-gray-50 p-3 rounded-xl border border-gray-200">
