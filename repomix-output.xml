<file path="app/api/create-session/route.ts">
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { verifyLecturer } from '@/utils/api-auth';
import { headers } from 'next/headers';
import webpush from 'web-push';

export const dynamic = 'force-dynamic';

// Configure web-push with your VAPID keys
const publicVapidKey = process.env.NEXT_PUBLIC_VAPID_PUBLIC_KEY || '';
const privateVapidKey = process.env.VAPID_PRIVATE_KEY || '';
const subject = process.env.VAPID_SUBJECT || 'mailto:admin@campuscheck.com';

if (publicVapidKey && privateVapidKey) {
  webpush.setVapidDetails(subject, publicVapidKey, privateVapidKey);
}

export async function POST(request: Request) {
  try {
    const body = await request.json();
    const courseCodeToSave = body.courseCode || body.course_code;
    const isRepStarting = body.startedBy === 'Class Rep';
    
    const headersList = await headers();
    const forwarded = headersList.get('x-forwarded-for');
    const lecturerIp = forwarded ? forwarded.split(',')[0].trim() : (headersList.get('x-real-ip') || 'unknown-ip');

    let authUserId = null;
    let finalStartedBy = 'lecturer';

    if (isRepStarting) {
      const { data: rep } = await supabase
        .from('student_profiles')
        .select('is_class_rep')
        .eq('matric_number', body.repMatric)
        .single();

      if (!rep?.is_class_rep) {
        return NextResponse.json({ error: 'Unauthorized: Not a valid Class Rep' }, { status: 403 });
      }
      finalStartedBy = 'Class Rep';
    } else {
      const auth = await verifyLecturer(request);
      if (auth.error) return auth.error;
      authUserId = auth.user.id;
    }

    if (!courseCodeToSave) {
      return NextResponse.json({ error: "Missing course code." }, { status: 400 });
    }

    if (!isRepStarting) {
      const { data: course } = await supabase
        .from('courses')
        .select('id')
        .eq('course_code', courseCodeToSave)
        .eq('lecturer_id', authUserId)
        .single();

      if (!course) return NextResponse.json({ error: 'Unauthorized for this course' }, { status: 403 });
    }

    const parsedDuration = parseInt(body.duration);
    const durationMinutes = Number.isFinite(parsedDuration) ? Math.min(Math.max(parsedDuration, 5), 120) : 60;
    const parsedWait = parseInt(body.checkinOpensAfter);
    const checkinOpensAfterMinutes = Number.isFinite(parsedWait) ? Math.min(Math.max(parsedWait, 0), 60) : 10;

    const expiresAt = new Date(Date.now() + durationMinutes * 60000).toISOString();

    const { data, error } = await supabase
      .from('lecture_sessions')
      .insert([{
        course_code: courseCodeToSave,
        anchor_latitude: body.latitude || body.lat,
        anchor_longitude: body.longitude || body.lng,
        anchor_ip: lecturerIp, 
        is_active: true,
        expires_at: expiresAt,
        checkin_opens_after_minutes: checkinOpensAfterMinutes,
        started_by: finalStartedBy
      }])
      .select('session_id')
      .single();

    if (error) {
      console.error("Database Insert Error:", error);
      return NextResponse.json({ error: error.message || "Database error" }, { status: 500 });
    }

    // ─── NEW: SEND PUSH NOTIFICATIONS ───
    try {
      // 1. Get all students enrolled in this course
      const { data: course } = await supabase.from('courses').select('id').eq('course_code', courseCodeToSave).single();
      
      if (course) {
        const { data: enrollments } = await supabase.from('enrollments').select('matric_number').eq('course_id', course.id);
        
        if (enrollments && enrollments.length > 0) {
          const matrics = enrollments.map(e => e.matric_number);
          
          // 2. Find any of these students who have a push subscription
          const { data: subscriptions } = await supabase
            .from('push_subscriptions')
            .select('subscription')
            .in('matric_number', matrics);

          // 3. Blast the notification
          if (subscriptions && subscriptions.length > 0) {
            const payload = JSON.stringify({
              title: `Class is Live: ${courseCodeToSave}`,
              body: `The lecturer has started attendance. Tap to check in now!`,
              url: `/?sessionId=${data.session_id}` // Direct link to check-in
            });

            const pushPromises = subscriptions.map(sub => 
              webpush.sendNotification(sub.subscription, payload).catch(err => {
                // If the subscription is expired (410), delete it from DB
                if (err.statusCode === 410) {
                  return supabase.from('push_subscriptions').delete().eq('subscription', sub.subscription);
                }
              })
            );

            await Promise.all(pushPromises);
          }
        }
      }
    } catch (pushError) {
      console.error("Push notification failed, but session was created:", pushError);
      // We don't return an error here because the session WAS created successfully.
    }

    return NextResponse.json({
      sessionId: data.session_id,
      expiresAt,
      checkinOpensAfterMinutes
    });

  } catch (err) {
    const message = err instanceof Error ? err.message : "Unknown error";
    console.error("CREATE SESSION FATAL ERROR:", message);
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
</file>

<file path="app/login/page.tsx">
'use client';
import { useState } from 'react';
import { useRouter } from 'next/navigation';
import { supabase } from '../../utils/supabase';
import { ShieldCheck, Loader2, Mail, Lock, User, Users, KeyRound, AlertTriangle, ArrowLeft } from 'lucide-react';
import Link from 'next/link';

export default function LoginPage() {
  const router = useRouter();
  const [isLogin, setIsLogin] = useState(true);
  
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [fullName, setFullName] = useState('');
  const [department, setDepartment] = useState('');
  const [secretKey, setSecretKey] = useState('');
  
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const handleAuth = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setError('');

    try {
      if (isLogin) {
        const { data, error: signInError } = await supabase.auth.signInWithPassword({ email, password });
        
        if (signInError) throw signInError;
        
        if (data.session) {
          router.refresh();
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 800);
        } else {
          throw new Error("Login successful, but no session was created.");
        }
      } else {
        // SECURE SIGNUP: Hits our new server route
        const res = await fetch('/api/lecturer-signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, fullName, department, secretKey })
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Registration failed');
        }

        alert('Registration successful! You can now log in.');
        setIsLogin(true);
        setLoading(false);
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Authentication failed';
      setError(msg);
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 flex flex-col items-center justify-center p-4 sm:p-6 font-sans relative overflow-hidden">
      <div className="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div className="w-full max-w-md relative z-10">
        
        <div className="mb-4">
          <Link href="/" className="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-gray-900 transition-colors bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm">
            <ArrowLeft size={16} /> Back to Hub
          </Link>
        </div>

        <div className="text-center mb-8 flex flex-col items-center justify-center animate-in fade-in slide-in-from-bottom-4">
          <div className="bg-[#2563EB] w-20 h-20 rounded-3xl flex items-center justify-center shadow-2xl shadow-blue-500/40 mb-5 relative overflow-hidden group hover:scale-105 transition-transform duration-300">
            <ShieldCheck className="w-10 h-10 text-white z-10" strokeWidth={2.5} />
            <div className="absolute top-0 left-0 w-full h-1/2 bg-white/20 rounded-t-3xl"></div>
          </div>
          <h1 className="text-3xl font-black text-gray-900 tracking-tight">Faculty Access</h1>
          <p className="text-gray-600 mt-2 font-semibold text-base">CampusCheck Administration</p>
        </div>

        <div className="bg-white rounded-3xl shadow-2xl shadow-gray-300/30 border border-gray-100 p-6 sm:p-8 animate-in fade-in slide-in-from-bottom-6">
          
          <div className="flex bg-gray-100 p-1.5 rounded-xl mb-8">
            <button onClick={() => {setIsLogin(true); setError('');}} className={`flex-1 py-2.5 rounded-lg text-sm font-bold transition-all ${isLogin ? 'bg-white text-gray-900 shadow-sm border border-gray-200' : 'text-gray-500 hover:text-gray-700'}`}>Sign In</button>
            <button onClick={() => {setIsLogin(false); setError('');}} className={`flex-1 py-2.5 rounded-lg text-sm font-bold transition-all ${!isLogin ? 'bg-white text-gray-900 shadow-sm border border-gray-200' : 'text-gray-500 hover:text-gray-700'}`}>Register</button>
          </div>

          <form onSubmit={handleAuth} className="space-y-4">
            {!isLogin && (
              <>
                <div className="relative">
                  <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"><User size={18} className="text-gray-400" /></div>
                  <input aria-label="Full Name" type="text" required placeholder="Full Name" value={fullName} onChange={(e) => setFullName(e.target.value)} className="w-full bg-gray-50 border border-gray-200 text-gray-900 font-bold py-3.5 pl-11 pr-4 rounded-xl outline-none focus:ring-2 focus:ring-[#2563EB] transition-all" />
                </div>
                <div className="relative">
                  <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"><Users size={18} className="text-gray-400" /></div>
                  <input aria-label="Department" type="text" required placeholder="Department (e.g., CSC)" value={department} onChange={(e) => setDepartment(e.target.value.toUpperCase())} className="w-full bg-gray-50 border border-gray-200 text-gray-900 font-bold py-3.5 pl-11 pr-4 rounded-xl outline-none focus:ring-2 focus:ring-[#2563EB] transition-all uppercase" />
                </div>
                <div className="relative">
                  <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"><KeyRound size={18} className="text-gray-400" /></div>
                  <input aria-label="Faculty Registration Key" type="password" required placeholder="Faculty Registration Key" value={secretKey} onChange={(e) => setSecretKey(e.target.value)} className="w-full bg-blue-50 border border-blue-200 text-blue-900 font-bold py-3.5 pl-11 pr-4 rounded-xl outline-none focus:ring-2 focus:ring-[#2563EB] transition-all placeholder:text-blue-400" />
                </div>
              </>
            )}

            <div className="relative">
              <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"><Mail size={18} className="text-gray-400" /></div>
              <input aria-label="Email Address" type="email" required placeholder="Email Address" value={email} onChange={(e) => setEmail(e.target.value)} className="w-full bg-gray-50 border border-gray-200 text-gray-900 font-bold py-3.5 pl-11 pr-4 rounded-xl outline-none focus:ring-2 focus:ring-[#2563EB] transition-all" />
            </div>

            <div className="relative">
              <div className="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none"><Lock size={18} className="text-gray-400" /></div>
              <input aria-label="Password" type="password" required placeholder="Password" value={password} onChange={(e) => setPassword(e.target.value)} className="w-full bg-gray-50 border border-gray-200 text-gray-900 font-bold py-3.5 pl-11 pr-4 rounded-xl outline-none focus:ring-2 focus:ring-[#2563EB] transition-all" />
            </div>

            {error && (
              <div className="p-3 bg-red-50 rounded-xl border border-red-100 flex items-start gap-2 animate-in fade-in">
                <AlertTriangle size={16} className="text-red-500 shrink-0 mt-0.5" />
                <p className="text-red-700 font-bold text-sm">{error}</p>
              </div>
            )}

            <button type="submit" disabled={loading} className="w-full flex items-center justify-center gap-2 bg-[#2563EB] text-white font-black text-lg py-4 rounded-xl shadow-lg shadow-blue-500/20 hover:bg-blue-700 active:scale-[0.98] transition-all disabled:opacity-70 mt-6">
              {loading ? <Loader2 className="animate-spin" size={20} /> : <ShieldCheck size={20} />} 
              {isLogin ? 'Sign In Securely' : 'Create Faculty Account'}
            </button>
          </form>
        </div>

        <div className="mt-8 text-center animate-in fade-in pb-8">
          <p className="text-xs font-bold text-gray-400">© 2026 CampusCheck. All rights reserved.</p>
        </div>

      </div>
    </div>
  );
}
</file>

<file path="app/dashboard/analytics/page.tsx">
'use client';
import { useState, useEffect, useCallback } from 'react';
import { 
  BarChart3, AlertTriangle, Calendar, Download, Loader2, FileSpreadsheet, CheckCircle, ChevronDown, ChevronUp, Lock
} from 'lucide-react';
import { supabase } from '@/utils/supabase';

interface CourseRow {
  id: string;
  course_code: string;
  max_attendance_score: number;
  is_finalized: boolean;
}

interface StudentReportRow {
  matricNumber: string;
  totalClasses: number;
  attended: number;
  percentage: number;
  eligible: 'YES' | 'NO';
}

interface ReportData {
  course: string;
  totalClasses: number;
  plannedClasses: number;
  maxScore: number;
  isFinalized: boolean;
  report: StudentReportRow[];
}

export default function AnalyticsPage() {
  const [courses, setCourses] = useState<CourseRow[]>([]);
  const [selectedCourseCode, setSelectedCourseCode] = useState<string>('');
  const [selectedCourse, setSelectedCourse] = useState<CourseRow | null>(null);

  const [startDate, setStartDate] = useState('');
  const [endDate, setEndDate] = useState('');
  const [showAdvanced, setShowAdvanced] = useState(false);
  const [showWatchlist, setShowWatchlist] = useState(false);

  const [reportData, setReportData] = useState<ReportData | null>(null);
  const [isLoading, setIsLoading] = useState(false);
  const [isDownloading, setIsDownloading] = useState(false);
  const [isFinalizing, setIsFinalizing] = useState(false);
  const [lockGrades, setLockGrades] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  const getHeaders = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    return {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${session?.access_token || ''}`
    };
  };

  useEffect(() => {
    const fetchCourses = async () => {
      const { data } = await supabase.from('courses').select('id, course_code, max_attendance_score, is_finalized');
      if (data && data.length > 0) {
        setCourses(data);
        setSelectedCourseCode(data[0].course_code);
        setSelectedCourse(data[0]);
      }
    };
    fetchCourses();
  }, []);

  const handleCourseChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const code = e.target.value;
    setSelectedCourseCode(code);
    const course = courses.find(c => c.course_code === code);
    if (course) setSelectedCourse(course);
  };

  const fetchReportData = useCallback(async (useFilters: boolean = false) => {
    if (!selectedCourseCode) return;
    setIsLoading(true);
    setErrorMessage(null);
    try {
      let url = `/api/master-export?courseCode=${selectedCourseCode}`;
      if (useFilters) {
        if (startDate) url += `&startDate=${startDate}`;
        if (endDate) url += `&endDate=${endDate}`;
      }
      const headers = await getHeaders();
      const response = await fetch(url, { headers });

      if (response.status === 404) {
        setReportData(null);
        setErrorMessage("No classes found for this timeframe.");
        return;
      }

      if (!response.ok) throw new Error("Failed to load analytics.");

      const data = await response.json();
      setReportData(data);
    } catch (err) {
      const message = err instanceof Error ? err.message : "Failed to load analytics.";
      setErrorMessage(message);
      setReportData(null);
    } finally {
      setIsLoading(false);
    }
  }, [selectedCourseCode, startDate, endDate]);

  useEffect(() => {
    if (!selectedCourseCode) return;
    const id = setTimeout(() => { fetchReportData(false); }, 0);
    return () => clearTimeout(id);
  }, [selectedCourseCode, fetchReportData]);

  const handleDownload = async (isFullSemester: boolean) => {
    if (!reportData || !reportData.report || !selectedCourse) return;
    
    if (lockGrades && !selectedCourse.is_finalized) {
      if (reportData.totalClasses < reportData.plannedClasses) {
        const confirm = window.confirm(`⚠️ WARNING: You planned ${reportData.plannedClasses} classes but only held ${reportData.totalClasses}.\n\nIf you lock grades now, the system will calculate final scores based on the ${reportData.totalClasses} actual classes held.\n\nDo you want to proceed?`);
        if (!confirm) return;
      } else {
        const confirm = window.confirm(`Are you sure? This will finalize the semester and lock CA scores. No more sessions can be held for this course.`);
        if (!confirm) return;
      }
    }

    setIsDownloading(true);

    if (lockGrades && !selectedCourse.is_finalized) {
      setIsFinalizing(true);
      const { error } = await supabase
        .from('courses')
        .update({ is_finalized: true })
        .eq('id', selectedCourse.id);
      
      if (error) {
        alert("Failed to lock grades in the database.");
        setIsFinalizing(false);
        setIsDownloading(false);
        return;
      }
      
      setCourses(prev => prev.map(c => c.id === selectedCourse.id ? { ...c, is_finalized: true } : c));
      setSelectedCourse(prev => prev ? { ...prev, is_finalized: true } : null);
      setLockGrades(false); 
    }

    const maxScore = reportData.maxScore || 10;
    const timeLabel = isFullSemester ? "FULL SEMESTER LEDGER" : `CUSTOM RANGE: ${startDate || 'Start'} to ${endDate || 'End'}`;
    const datePrinted = new Date().toLocaleDateString();
    const finalStatus = (selectedCourse.is_finalized || lockGrades) ? "FINALIZED" : "LIVE (UNFINALIZED)";

    const header = [
      [`OFFICIAL ATTENDANCE REPORT - ${finalStatus}`],
      [`Course Code:`, selectedCourseCode],
      [`Reporting Period:`, timeLabel],
      [`Total Classes Held:`, reportData.totalClasses],
      [`Date Generated:`, datePrinted],
      [],
      ["S/N", "MATRICULATION NUMBER", "TOTAL CLASSES", "ATTENDED", "PERCENTAGE (%)", `CA SCORE (/${maxScore})`, "REMARK"]
    ];

    const sortedReport = [...reportData.report].sort((a, b) => a.matricNumber.localeCompare(b.matricNumber));

    const rows = sortedReport.map((s, index) => {
      const caScore = ((s.percentage / 100) * maxScore).toFixed(1);
      return [
        index + 1,
        s.matricNumber,
        s.totalClasses,
        s.attended,
        s.percentage,
        caScore,
        s.eligible === 'YES' ? "CLEARED" : "NOT ELIGIBLE"
      ];
    });

    const csvContent = [...header, ...rows].map(row => row.join(",")).join("\n");
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });

    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.setAttribute("download", `${selectedCourseCode}_Senate_Report_${isFullSemester ? 'Full' : 'Custom'}.csv`);

    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);

    setIsFinalizing(false);
    setIsDownloading(false);
  };

  const applyCustomDates = () => { fetchReportData(true); };

  const atRiskStudents: StudentReportRow[] = reportData?.report?.filter(s => s.eligible === 'NO') || [];
  const maxScore = reportData?.maxScore || 10;

  return (
    <div className="min-h-screen bg-gray-50 p-6 md:p-10 font-sans">
      <div className="max-w-4xl mx-auto space-y-8">

        <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
          <div>
            <h1 className="text-2xl font-extrabold text-gray-900 flex items-center gap-3">
              <BarChart3 className="text-[#2563EB]" size={28} /> Analytics & Reports
            </h1>
            <p className="text-gray-500 font-medium mt-1 text-sm">Generate final gradebooks and monitor exam eligibility.</p>
          </div>
          <select
            aria-label="Select Course for Analytics"
            value={selectedCourseCode}
            onChange={handleCourseChange}
            disabled={courses.length === 0}
            className="bg-gray-50 border border-gray-200 text-gray-900 font-bold py-3 px-4 rounded-xl outline-none focus:ring-2 focus:ring-[#2563EB] shadow-sm min-w-50 cursor-pointer"
          >
            {courses.length === 0
              ? <option>No Courses Found</option>
              : courses.map(c => <option key={c.id} value={c.course_code}>{c.course_code}</option>)
            }
          </select>
        </div>

        <div className="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-gray-200">
          <div className="flex items-center gap-4 mb-8">
            <div className="bg-green-100 p-4 rounded-xl text-green-700">
              <FileSpreadsheet size={28} />
            </div>
            <div>
              <h3 className="text-xl font-extrabold text-gray-900">Semester Gradebook</h3>
              <p className="text-sm font-bold text-gray-400 uppercase tracking-wider mt-1">{reportData?.totalClasses || 0} Classes Held</p>
            </div>
          </div>

          <div className="mb-6 bg-blue-50 border border-blue-200 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div className="flex items-start gap-3">
              <Lock className="text-blue-600 mt-0.5 shrink-0" size={20} />
              <div>
                <p className="font-bold text-blue-900 text-sm">Lock Final Grades</p>
                <p className="text-xs text-blue-700 font-medium mt-0.5">Check this to permanently calculate CA scores and end the semester for this course.</p>
              </div>
            </div>
            <label className="flex items-center gap-2 cursor-pointer bg-white px-3 py-1.5 rounded-lg border border-blue-200 shadow-sm">
              <input 
                type="checkbox" 
                checked={lockGrades || selectedCourse?.is_finalized} 
                onChange={(e) => setLockGrades(e.target.checked)}
                disabled={selectedCourse?.is_finalized}
                className="w-4 h-4 text-blue-600 rounded focus:ring-blue-500"
              />
              <span className="text-xs font-bold text-gray-700 uppercase tracking-wider">
                {selectedCourse?.is_finalized ? "Finalized" : "Lock Grades"}
              </span>
            </label>
          </div>

          <button
            onClick={() => handleDownload(true)}
            disabled={isDownloading || isFinalizing || !reportData}
            className="w-full flex justify-center items-center gap-2 bg-green-600 text-white font-bold py-4 rounded-xl hover:bg-green-700 disabled:opacity-50 transition-all shadow-md active:scale-[0.98] text-lg mb-6"
          >
            {isDownloading || isFinalizing ? <Loader2 size={24} className="animate-spin" /> : <Download size={24} />}
            Download Full Semester CSV
          </button>

          <div className="border-t border-gray-100 pt-6">
            <button
              onClick={() => setShowAdvanced(!showAdvanced)}
              className="w-full flex justify-between items-center text-sm font-bold text-gray-500 hover:text-gray-900 transition-colors bg-gray-50 p-4 rounded-xl border border-gray-200"
            >
              <span className="flex items-center gap-2"><Calendar size={16}/> Custom Date Range</span>
              {showAdvanced ? <ChevronUp size={16} /> : <ChevronDown size={16} />}
            </button>

            {showAdvanced && (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 animate-in fade-in slide-in-from-top-2">
                <div>
                  <label className="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">From</label>
                  <input
                    type="date"
                    value={startDate}
                    onChange={(e) => setStartDate(e.target.value)}
                    className="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 px-4 font-bold text-gray-900 outline-none focus:ring-2 focus:ring-[#2563EB]"
                  />
                </div>
                <div>
                  <label className="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">To</label>
                  <input
                    type="date"
                    value={endDate}
                    onChange={(e) => setEndDate(e.target.value)}
                    min={startDate}
                    className="w-full bg-gray-50 border border-gray-200 rounded-xl py-3 px-4 font-bold text-gray-900 outline-none focus:ring-2 focus:ring-[#2563EB]"
                  />
                </div>
                <div className="md:col-span-2 grid grid-cols-2 gap-2 mt-2">
                  <button
                    onClick={applyCustomDates}
                    className="bg-gray-100 text-gray-700 font-bold py-3 rounded-xl hover:bg-gray-200 transition-all text-sm"
                  >
                    Apply Filters
                  </button>
                  <button
                    onClick={() => handleDownload(false)}
                    disabled={isDownloading || isFinalizing || !reportData}
                    className="flex justify-center items-center gap-2 bg-gray-900 text-white font-bold py-3 rounded-xl hover:bg-gray-800 disabled:opacity-50 transition-all shadow-sm text-sm"
                  >
                    <Download size={16} /> Export Range
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>

        <div className="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <button
            onClick={() => setShowWatchlist(!showWatchlist)}
            className="w-full flex items-center justify-between p-6 bg-white hover:bg-gray-50 transition-colors text-left"
          >
            <div className="flex items-center gap-3">
              <div className={`p-2 rounded-lg ${atRiskStudents.length > 0 ? 'bg-red-100 text-red-600' : 'bg-green-100 text-green-600'}`}>
                {atRiskStudents.length > 0 ? <AlertTriangle size={20} /> : <CheckCircle size={20} />}
              </div>
              <div>
                <h3 className="font-extrabold text-gray-900 text-lg">Exam Eligibility Watchlist</h3>
                <p className="text-xs text-gray-500 font-medium mt-0.5">
                  {atRiskStudents.length > 0
                    ? `${atRiskStudents.length} students currently below 70%`
                    : "All students are eligible for the exam."}
                </p>
              </div>
            </div>
            <div className="text-gray-400">
              {showWatchlist ? <ChevronUp size={24} /> : <ChevronDown size={24} />}
            </div>
          </button>

          {showWatchlist && (
            <div className="border-t border-gray-100 bg-gray-50/50 p-4 animate-in fade-in slide-in-from-top-2">
              {isLoading ? (
                <div className="flex flex-col items-center justify-center h-32">
                  <Loader2 className="animate-spin text-[#2563EB]" size={24}/>
                </div>
              ) : atRiskStudents.length === 0 ? (
                <div className="text-center p-8 text-green-600 font-bold">No students at risk!</div>
              ) : (
                <div className="bg-white border border-gray-200 rounded-xl overflow-x-auto">
                  <table className="w-full text-left whitespace-nowrap min-w-125">
                    <thead>
                      <tr className="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-400">
                        <th className="px-6 py-3 font-bold">Matric Number</th>
                        <th className="px-6 py-3 font-bold text-center">Attendance</th>
                        <th className="px-6 py-3 font-bold text-right">CA Score</th>
                        <th className="px-6 py-3 font-bold text-right">Standing</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-50">
                      {atRiskStudents.map((student, i) => (
                        <tr key={i} className="hover:bg-red-50/20 transition-colors">
                          <td className="px-6 py-3 font-black text-gray-900">{student.matricNumber}</td>
                          <td className="px-6 py-3 text-center font-bold text-gray-600">{student.attended} / {student.totalClasses}</td>
                          <td className="px-6 py-3 text-right font-bold text-gray-600">
                            {((student.percentage / 100) * maxScore).toFixed(1)} / {maxScore}
                          </td>
                          <td className="px-6 py-3 text-right">
                            <span className="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-black bg-red-100 text-red-700">
                              {student.percentage}%
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}
        </div>

        {errorMessage && (
          <div className="bg-red-50 border border-red-100 rounded-2xl p-4 text-center">
            <p className="text-red-700 font-bold text-sm">{errorMessage}</p>
          </div>
        )}

      </div>
    </div>
  );
}
</file>

<file path="app/api/verify-attendance/route.ts">
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { checkRateLimit, getClientIp, rateLimitHeaders } from '@/utils/rate-limit';
import { RATE_LIMIT_DEFAULTS, GEOFENCE_RADIUS_METERS, GEOFENCE_HARD_BLOCK_METERS } from '@/utils/constants';

interface Telemetry {
  lat: number;
  lng: number;
  alt: number | null;
  acc: number;
  timestamp: number;
}

function getDistanceInMeters(lat1: number, lon1: number, lat2: number, lon2: number) {
  const R = 6371e3;
  const φ1 = lat1 * Math.PI / 180;
  const φ2 = lat2 * Math.PI / 180;
  const Δφ = (lat2 - lat1) * Math.PI / 180;
  const Δλ = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(Δφ / 2) * Math.sin(Δφ / 2) + Math.cos(φ1) * Math.cos(φ2) * Math.sin(Δλ / 2) * Math.sin(Δλ / 2);
  return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
}

export async function POST(request: Request) {
  try {
    const ip = getClientIp(request);
    const limit = RATE_LIMIT_DEFAULTS['verify-attendance'];
    const rateCheck = checkRateLimit(`verify-att:${ip}`, limit);

    if (!rateCheck.allowed) {
      return NextResponse.json(
        { message: "Too many requests. Please wait a minute." },
        { status: 429, headers: rateLimitHeaders(rateCheck) }
      );
    }

    const body = await request.json();
    const { sessionId, matricNumber, telemetry, hardwareFingerprint, deviceFingerprint, verificationMethod, userAgent } = body;
    
    if (!matricNumber || !sessionId) {
      return NextResponse.json({ message: "Invalid payload" }, { status: 400 });
    }

    const isIOS = /iPad|iPhone|iPod/.test(userAgent || '');
    const cleanMatric = matricNumber.toUpperCase().trim();

    if (!telemetry || telemetry.length === 0) {
      return NextResponse.json({ message: "Invalid payload" }, { status: 400 });
    }

    const { data: session, error: sessionError } = await supabase
      .from('lecture_sessions')
      .select('anchor_latitude, anchor_longitude, anchor_ip, is_active, course_code, expires_at, created_at, checkin_opens_after_minutes')
      .eq('session_id', sessionId)
      .single();

    if (sessionError || !session) return NextResponse.json({ message: "Invalid or expired session link." }, { status: 404 });
    if (session.is_active !== true) return NextResponse.json({ message: "Attendance window has been manually closed." }, { status: 403 });
    if (session.expires_at && new Date() > new Date(session.expires_at)) return NextResponse.json({ message: "Time's up. The attendance window has closed." }, { status: 403 });

    const opensAfter = session.checkin_opens_after_minutes ?? 10;
    if (opensAfter > 0 && session.created_at) {
      const sessionStart = new Date(session.created_at).getTime();
      const now = Date.now();
      const elapsedMinutes = (now - sessionStart) / 60000;
      if (elapsedMinutes < opensAfter) {
        const remaining = Math.ceil(opensAfter - elapsedMinutes);
        return NextResponse.json({ message: `Attendance opens in ${remaining} minute${remaining === 1 ? '' : 's'}. Wait until the lecture has started.` }, { status: 403 });
      }
    }

    const { data: courseRow } = await supabase.from('courses').select('id').eq('course_code', session.course_code).limit(1).maybeSingle();
    if (!courseRow) return NextResponse.json({ message: "Course configuration error." }, { status: 500 });

    const { data: enrollment } = await supabase.from('enrollments').select('id').eq('course_id', courseRow.id).eq('matric_number', cleanMatric).maybeSingle();
    if (!enrollment) return NextResponse.json({ message: `You are not registered for ${session.course_code}. Please contact your lecturer.` }, { status: 403 });

    const { data: existingLog } = await supabase
      .from('attendance_logs')
      .select('id, status, device_info')
      .eq('session_id', sessionId)
      .eq('matric_number', cleanMatric)
      .single();

    if (existingLog && existingLog.status === 'verified') {
      return NextResponse.json({ message: "You have already checked in to this session." }, { status: 409 });
    }

    let disqualificationReason: string | null = null;

    if (hardwareFingerprint && hardwareFingerprint !== 'unknown-hardware') {
      const { data: ghostLogs } = await supabase
        .from('attendance_logs')
        .select('matric_number')
        .eq('session_id', sessionId)
        .eq('device_hash', hardwareFingerprint)
        .eq('status', 'verified');

      if (ghostLogs && ghostLogs.length > 0) {
        disqualificationReason = 'proxy-device-reuse';
      }
    }

    let isSpoofed = false;
    const validPings = (telemetry as Telemetry[]).filter((t: Telemetry) => t.acc > 0);
    const pingsToUse = validPings.length > 0 ? validPings : telemetry;

    for (let i = 1; i < pingsToUse.length; i++) {
      const drift = getDistanceInMeters(pingsToUse[i-1].lat, pingsToUse[i-1].lng, pingsToUse[i].lat, pingsToUse[i].lng);
      const timeDeltaSec = Math.abs(pingsToUse[i].timestamp - pingsToUse[i-1].timestamp) / 1000;
      if (timeDeltaSec > 0 && drift / timeDeltaSec > 200) isSpoofed = true;
    }

    if (isSpoofed) {
      disqualificationReason = 'gps-spoof-pattern';
    }

    // THE IP CHECK: If they are on the same network as the lecturer, they are inside.
    const isOnSameNetwork = session.anchor_ip && session.anchor_ip === ip;

    // THE iOS SPECIAL CASE
    const allowedRadius = isIOS ? 500 : GEOFENCE_RADIUS_METERS;
    const hardBlockRadius = isIOS ? 1000 : GEOFENCE_HARD_BLOCK_METERS;

    let bestDistance = Infinity;
    for (let i = 0; i < pingsToUse.length; i++) {
      const ping = pingsToUse[i];
      const dist = getDistanceInMeters(session.anchor_latitude, session.anchor_longitude, ping.lat, ping.lng);
      if (dist < bestDistance) bestDistance = dist;
    }

    let finalStatus = 'absent';
    let responseMessage = `You are ${Math.round(bestDistance)}m away (max: ${allowedRadius}m).`;

    if (disqualificationReason) {
      finalStatus = 'disqualified';
      responseMessage = "This attempt has been flagged as invalid. Please see your lecturer in person.";
    } else if (isOnSameNetwork || bestDistance <= allowedRadius) {
      finalStatus = 'verified';
      responseMessage = isOnSameNetwork ? "Verified via Campus Wi-Fi" : (verificationMethod === 'skipped' ? "Verified via GPS (No Biometrics)" : "Verified");
    } else if (bestDistance > hardBlockRadius) {
      finalStatus = 'flagged';
      responseMessage = "You are too far from the lecture hall.";
    } else {
      finalStatus = 'flagged';
      responseMessage = `You are ${Math.round(bestDistance)}m away. You must be inside the lecture hall.`;
    }

    if (existingLog) {
      if (existingLog.status === 'disqualified') {
        finalStatus = 'disqualified';
        responseMessage = "This attempt was previously disqualified. See your lecturer in person.";
      } else {
        try {
          const prevInfo = existingLog.device_info ? JSON.parse(existingLog.device_info) : {};
          if (prevInfo.disqualificationReason) {
            finalStatus = 'disqualified';
            responseMessage = "This attempt was previously disqualified. See your lecturer in person.";
          }
        } catch {}
      }
    }

    const deviceInfoPayload = JSON.stringify({ 
      telemetry, 
      evaluatedDistance: Math.round(bestDistance), 
      distanceMeters: Math.round(bestDistance), 
      deviceFingerprint, 
      verificationMethod,
      disqualificationReason,
      isIOS,
      isOnSameNetwork
    });

    if (existingLog) {
      await supabase.from('attendance_logs').update({
        status: finalStatus,
        device_info: deviceInfoPayload,
        device_hash: hardwareFingerprint || 'unknown-hardware',
      }).eq('id', existingLog.id);
    } else {
      await supabase.from('attendance_logs').insert([{
        session_id: sessionId,
        matric_number: cleanMatric,
        status: finalStatus,
        device_info: deviceInfoPayload,
        device_hash: hardwareFingerprint || 'unknown-hardware',
      }]);
    }

    return NextResponse.json({ status: finalStatus, distance: Math.round(bestDistance), message: responseMessage }, { status: 200, headers: rateLimitHeaders(rateCheck) });

  } catch (error) {
    console.error("Verification API Error:", error);
    return NextResponse.json({ message: "Internal server error" }, { status: 500 });
  }
}
