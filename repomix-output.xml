                            {activeTab === 'records' && (
                                <div className="space-y-3 fade-in">
                                    {logs.filter(l => l.matric === 'CSC/2021/001').map((log, i) => (
                                        <div key={i} className="bg-gray-50 p-4 rounded-xl border border-gray-200 flex justify-between items-center">
