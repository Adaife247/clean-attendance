<file path="app/api/admin-login/route.ts">
import { NextResponse } from 'next/server';
import { cookies } from 'next/headers';
import crypto from 'crypto';
import { checkRateLimit, getClientIp, rateLimitHeaders } from '@/utils/rate-limit';
import { RATE_LIMIT_DEFAULTS } from '@/utils/constants';

function safeCompare(a: string, b: string): boolean {
  const bufA = Buffer.from(a);
  const bufB = Buffer.from(b);

  const maxLen = Math.max(bufA.length, bufB.length);
  const padA = Buffer.alloc(maxLen);
  const padB = Buffer.alloc(maxLen);
  bufA.copy(padA);
  bufB.copy(padB);

  const equal = crypto.timingSafeEqual(padA, padB);
  return equal && bufA.length === bufB.length;
}

export async function POST(request: Request) {
  try {
    const ip = getClientIp(request);
    const limit = RATE_LIMIT_DEFAULTS['admin-login'];
    const rateCheck = await checkRateLimit(`admin-login:${ip}`, limit);

    if (!rateCheck.allowed) {
      return NextResponse.json(
        { message: "Too many login attempts. Please try again in a minute." },
        { status: 429, headers: rateLimitHeaders(rateCheck) }
      );
    }

    const { password } = await request.json();
    const CORRECT_PASSWORD = process.env.ADMIN_PASSWORD;

    if (!CORRECT_PASSWORD) {
      return NextResponse.json({ message: "Server configuration missing." }, { status: 500 });
    }

    if (!password || typeof password !== 'string') {
      return NextResponse.json({ message: "Password required." }, { status: 400 });
    }

    if (safeCompare(password, CORRECT_PASSWORD)) {
      const cookieStore = await cookies();

      cookieStore.set({
        name: 'attendance_admin_token',
        value: 'verified',
        httpOnly: true,
        path: '/',
        secure: process.env.NODE_ENV === 'production',
        maxAge: 60 * 60 * 8,
      });

      return NextResponse.json({ success: true }, { headers: rateLimitHeaders(rateCheck) });
    }

    return NextResponse.json(
      { message: "Invalid password" },
      { status: 401, headers: rateLimitHeaders(rateCheck) }
    );

  } catch (error) {
    console.error("Login API Error:", error);
    return NextResponse.json({ message: "Internal server error" }, { status: 500 });
  }
}
</file>

<file path="app/api/master-export/route.ts">
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { verifyLecturer } from '@/utils/api-auth';

function sanitizeCSV(val: string | number) {
  const str = String(val);
  if (/^[=+\-@]/.test(str)) {
    return `'${str}`;
  }
  return str;
}

export async function GET(request: Request) {
  try {
    const auth = await verifyLecturer(request);
    if (auth.error) return auth.error;

    const { searchParams } = new URL(request.url);
    const courseCode = searchParams.get('courseCode');
    const startDate = searchParams.get('startDate');
    const endDate = searchParams.get('endDate');

    if (!courseCode) return NextResponse.json({ error: "Missing course code" }, { status: 400 });

    const { data: courseData } = await supabase
      .from('courses')
      .select('id, total_planned_classes, max_attendance_score, is_finalized')
      .eq('course_code', courseCode)
      .eq('lecturer_id', auth.user.id)
      .single();

    if (!courseData) {
      return NextResponse.json({ error: "Course not found or unauthorized" }, { status: 404 });
    }

    // 1. Get sessions in range
    let sessionQuery = supabase
      .from('lecture_sessions')
      .select('session_id')
      .eq('course_code', courseCode);

    if (startDate) sessionQuery = sessionQuery.gte('created_at', new Date(startDate).toISOString());
    if (endDate) {
      const end = new Date(endDate);
      end.setHours(23, 59, 59, 999);
      sessionQuery = sessionQuery.lte('created_at', end.toISOString());
    }

    const { data: sessions } = await sessionQuery;
    if (!sessions || sessions.length === 0) {
      return NextResponse.json({ message: "No sessions recorded for this timeframe." }, { status: 404 });
    }

    const sessionIds = sessions.map(s => s.session_id);
    const totalClassesHeld = sessions.length;

    // 2. Get the roster (small — one row per student)
    const { data: enrollments } = await supabase
      .from('enrollments')
      .select('matric_number')
      .eq('course_id', courseData.id);
    const roster = enrollments?.map(e => e.matric_number) || [];

    // 3. NEW: Get pre-aggregated counts from the SQL view
    // Instead of fetching 40,000 log rows, we fetch at most 2,000 rows
    const { data: counts } = await supabase
      .from('session_attendance_counts')
      .select('matric_number, verified_count')
      .in('session_id', sessionIds);

    // 4. Sum per-student totals
    const attendanceMap = new Map<string, number>();
    roster.forEach(matric => attendanceMap.set(matric, 0));

    (counts || []).forEach(row => {
      if (!attendanceMap.has(row.matric_number)) attendanceMap.set(row.matric_number, 0);
      attendanceMap.set(row.matric_number, attendanceMap.get(row.matric_number)! + 1);
    });

    const report = Array.from(attendanceMap.entries()).map(([matric, attended]) => {
      const percentage = Math.round((attended / totalClassesHeld) * 100);
      return {
        matricNumber: sanitizeCSV(matric),
        totalClasses: totalClassesHeld,
        attended,
        percentage,
        eligible: percentage >= 70 ? 'YES' : 'NO'
      };
    });

    report.sort((a, b) => a.matricNumber.localeCompare(b.matricNumber));

    return NextResponse.json({
      course: courseCode,
      totalClasses: totalClassesHeld,
      plannedClasses: courseData.total_planned_classes || 15,
      maxScore: courseData.max_attendance_score || 10,
      isFinalized: courseData.is_finalized || false,
      report
    });

  } catch {
    return NextResponse.json({ error: "Failed to generate export" }, { status: 500 });
  }
}
</file>

<file path="app/api/override-attendance/route.ts">
import { NextResponse } from 'next/server';
import { supabaseAdmin as supabase } from '@/utils/supabase-admin';
import { verifyLecturer } from '@/utils/api-auth';

export async function POST(request: Request) {
  try {
    const auth = await verifyLecturer(request);
    if (auth.error) return auth.error;

    const body = await request.json();
    const sessionId = body.sessionId || body.session_id || body.session;
    const rawMatric = body.matricNumber || body.matric_number || body.matric;

    if (!sessionId || !rawMatric) {
      return NextResponse.json({ message: "Missing data" }, { status: 400 });
    }

    const { data: session } = await supabase.from('lecture_sessions').select('course_code').eq('session_id', sessionId).single();
    if (!session) return NextResponse.json({ message: "Session not found" }, { status: 404 });

    const { data: course } = await supabase.from('courses').select('id').eq('course_code', session.course_code).eq('lecturer_id', auth.user.id).single();
    if (!course) return NextResponse.json({ message: "Unauthorized" }, { status: 403 });

    const cleanMatric = String(rawMatric).toUpperCase().trim();

    // NEW: Verify the student is actually enrolled in this course
    const { data: enrollment } = await supabase
      .from('enrollments')
      .select('id')
      .eq('course_id', course.id)
      .eq('matric_number', cleanMatric)
      .maybeSingle();

    if (!enrollment) {
      return NextResponse.json({ message: "Student is not enrolled in this course." }, { status: 403 });
    }

    const overrideTimestamp = new Date().toISOString();

    const { data: existingLog } = await supabase
      .from('attendance_logs')
      .select('id')
      .eq('session_id', sessionId)
      .eq('matric_number', cleanMatric)
      .single();

    if (existingLog) {
      await supabase
        .from('attendance_logs')
        .update({
          status: 'verified',
          device_info: JSON.stringify({ method: "Manual Override - Updated" }),
          approved_by: auth.user.id,
          override_timestamp: overrideTimestamp,
        })
        .eq('id', existingLog.id);
    } else {
      await supabase
        .from('attendance_logs')
        .insert([{
          session_id: sessionId,
          matric_number: cleanMatric,
          status: 'verified',
          device_info: JSON.stringify({ method: "Manual Override - Inserted" }),
          device_hash: 'manual-override',
          approved_by: auth.user.id,
          override_timestamp: overrideTimestamp,
        }]);
    }

    return NextResponse.json({ message: "Success" });
  } catch {
    return NextResponse.json({ message: "Override failed" }, { status: 500 });
  }
}
